---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Resultados — CalculusWeb">
  <div class="container">
    <header class="page-head page-head-row">
      <div>
        <h1 class="page-title">Resultados del cálculo</h1>
        <p class="page-lede mt-3">
          El análisis numérico completo de la curva dibujada,
          con cada área descompuesta según su signo.
        </p>
      </div>
      <a href="/" class="btn btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Volver a dibujar
      </a>
    </header>

    <div id="resultsContent">
      <div class="panel mb-5">
        <div class="panel-body px-6 pt-11 pb-9 text-center">
          <div class="mono mb-3.5 text-[13px] tracking-wider text-subtle">INTEGRAL DEFINIDA APROXIMADA</div>
          <div class="mono mb-1.5 font-display text-[34px] text-primary">∫ f(x) dx</div>
          <div class="mono readout-hero" id="signedIntegralHero">0.0000</div>
        </div>
      </div>

      <div class="readout mb-5">
        <div class="readout-cell">
          <div class="readout-bar"></div>
          <div class="readout-label">Integral firmada</div>
          <div class="readout-value" id="signedIntegral">0.0000</div>
        </div>
        <div class="readout-cell total">
          <div class="readout-bar"></div>
          <div class="readout-label">Área geométrica total</div>
          <div class="readout-value" id="totalArea">0.0000</div>
        </div>
        <div class="readout-cell positive">
          <div class="readout-bar"></div>
          <div class="readout-label">Área positiva</div>
          <div class="readout-value" id="positiveArea">0.0000</div>
        </div>
        <div class="readout-cell negative">
          <div class="readout-bar"></div>
          <div class="readout-label">Área negativa</div>
          <div class="readout-value" id="negativeArea">0.0000</div>
        </div>
      </div>

      <div class="panel mb-5">
        <div class="panel-header">
          <h2 class="section-title">Detalles del cálculo</h2>
        </div>
        <div class="panel-body">
          <div class="detail-rows">
            <div class="detail-row">
              <span class="detail-label">Puntos originales dibujados</span>
              <span class="detail-value mono" id="originalPoints">0</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Puntos procesados por el algoritmo</span>
              <span class="detail-value mono" id="processedPoints">0</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Intersecciones con el eje X</span>
              <span class="detail-value mono" id="intersections">0</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Trapecios evaluados</span>
              <span class="detail-value mono" id="trapezoidCount">0</span>
            </div>
          </div>
        </div>
      </div>

      <div class="panel mb-5">
        <div class="panel-header">
          <h2 class="section-title">Fórmulas utilizadas</h2>
        </div>
        <div class="panel-body">
          <div class="formula-block">
            <div class="formula-title">Regla del trapecio</div>
            <div class="formula-expression">Aᵢ = (yᵢ + yᵢ₊₁) / 2 × (xᵢ₊₁ − xᵢ)</div>
            <div class="formula-explanation">
              El área de cada trapecio se calcula promediando las alturas (valores Y) de dos
              puntos consecutivos y multiplicando por la base (diferencia en X).
            </div>
          </div>

          <div class="formula-block">
            <div class="formula-title">Integral aproximada</div>
            <div class="formula-expression">∫ f(x) dx ≈ Σ Aᵢ &nbsp;(suma de todos los trapecios)</div>
            <div class="formula-explanation">
              La integral definida se aproxima sumando las áreas de todos los trapecios formados
              por segmentos consecutivos de la curva. Las áreas bajo el eje X contribuyen negativamente.
            </div>
          </div>

          <div class="formula-block">
            <div class="formula-title">Área geométrica total</div>
            <div class="formula-expression">Área total = Σ |Aᵢ| &nbsp;(suma de valores absolutos)</div>
            <div class="formula-explanation">
              El área geométrica considera todas las regiones como positivas, sumando el valor
              absoluto de cada trapecio. Representa el área física total entre la curva y el eje X.
            </div>
          </div>

          <div class="formula-block">
            <div class="formula-title">Intersección con el eje X</div>
            <div class="formula-expression">x = x₁ − y₁ × (x₂ − x₁) / (y₂ − y₁)</div>
            <div class="formula-explanation">
              Cuando la curva cruza el eje X (cambio de signo en Y), se interpola linealmente
              para encontrar el punto exacto de intersección y dividir correctamente las regiones.
            </div>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header border-l-[3px] border-primary">
          <h2 class="section-title">Explicación educativa</h2>
        </div>
        <div class="panel-body">
          <div class="prose">
            <p>
              La aplicación aproxima el área bajo la curva dividiendo el trazo dibujado en
              pequeños segmentos y calculando el área de cada trapecio. Cada trapecio se forma
              entre dos puntos consecutivos de la curva y el eje X; la suma de estas áreas
              da la integral aproximada.
            </p>
            <p>
              Las regiones por encima del eje X aportan área
              <strong class="text-positive">positiva</strong>, y las regiones por debajo
              aportan área <strong class="text-negative">negativa</strong>. El
              <strong>área geométrica total</strong> es la suma de los valores absolutos:
              el área física total, sin considerar signos.
            </p>
            <p>
              La <strong>regla del trapecio</strong> es un método de integración numérica de
              primer orden. Su error es proporcional al cuadrado del ancho de los subintervalos,
              por lo que dibujar con más puntos —un trazo más fluido— mejora la precisión del resultado.
            </p>
          </div>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/calculo/" class="btn btn-primary">
              Ver la visualización 3D
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </a>
            <a href="/formula/" class="btn btn-ghost">Ver el proceso paso a paso</a>
          </div>
        </div>
      </div>
    </div>

    <div id="noResults" class="hidden px-5 py-20 text-center">
      <svg class="mb-5 text-subtle" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <h2 class="page-title mb-2.5 text-2xl">No hay resultados</h2>
      <p class="page-lede mx-auto mb-7">Dibuja una curva en la pantalla principal y calcula su área.</p>
      <a href="/" class="btn btn-primary">Ir al plano cartesiano</a>
    </div>
  </div>


  <script>
    const resultsData = sessionStorage.getItem('calculusResult');

    if (resultsData) {
      try {
        const data = JSON.parse(resultsData);
        const signed = data.signed_integral.toFixed(4);

        document.getElementById('signedIntegral').textContent = signed;
        document.getElementById('signedIntegralHero').textContent = signed;
        document.getElementById('totalArea').textContent = data.total_geometric_area.toFixed(4);
        document.getElementById('positiveArea').textContent = data.positive_area.toFixed(4);
        document.getElementById('negativeArea').textContent = data.negative_area.toFixed(4);
        document.getElementById('originalPoints').textContent = data.original_points || 0;
        document.getElementById('processedPoints').textContent = data.processed_points?.length || 0;
        document.getElementById('intersections').textContent = data.x_axis_intersections?.length || 0;
        document.getElementById('trapezoidCount').textContent = Math.max((data.processed_points?.length || 0) - 1, 0);
      } catch (e) {
        console.error('Error parsing results:', e);
        document.getElementById('resultsContent').style.display = 'none';
        document.getElementById('noResults').style.display = 'block';
      }
    } else {
      document.getElementById('resultsContent').style.display = 'none';
      document.getElementById('noResults').style.display = 'block';
    }
  </script>
</Layout>
