---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Fórmulas — CalculusWeb">
  <div class="container">
    <header class="page-head">
      <div>
        <h1 class="page-title">Fórmulas y metodología</h1>
        <p class="page-lede" style="margin-top: 12px;">
          El recorrido completo de una integral numérica:
          desde el trazo crudo hasta el número final, con cada fórmula en su sitio.
        </p>
      </div>
    </header>

    <div id="noDataMessage" style="display: none; text-align: center; padding: 80px 20px;">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--text-3)" stroke-width="1.4" style="margin-bottom: 20px;">
        <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <h2 class="page-title" style="font-size: 26px; margin-bottom: 10px;">No hay datos de cálculo</h2>
      <p class="page-lede" style="margin: 0 auto 28px;">Dibuja una curva en la pantalla principal y calcula su área para ver el proceso detallado.</p>
      <a href="/" class="btn btn-primary">Ir al plano cartesiano</a>
    </div>

    <div id="formulaContent">
      <section class="section" aria-labelledby="stepsTitle">
        <div class="section-head">
          <div>
            <h2 class="section-title" id="stepsTitle">Proceso paso a paso</h2>
            <p class="section-sub">Cada etapa del algoritmo, con su fórmula y la razón detrás de ella.</p>
          </div>
          <div class="badge"><span class="dot"></span><span id="summaryLine">—</span></div>
        </div>

        <div class="steps-timeline">
          <div class="step">
            <div class="step-index">1</div>
            <div class="step-title">Entrada de puntos</div>
            <p class="step-text">
              Cada punto dibujado P<sub>i</sub> tiene coordenadas (x<sub>i</sub>, y<sub>i</sub>).
              Se capturan del mouse, el dedo o el trackpad y se convierten al sistema matemático del plano.
            </p>
            <div class="formula-expression">P<sub>i</sub> = (x<sub>i</sub>, y<sub>i</sub>)</div>
            <div class="step-meta">Puntos dibujados: <span class="mono strong" id="originalPointsCount">0</span></div>
          </div>

          <div class="step">
            <div class="step-index">2</div>
            <div class="step-title">Limpieza de datos</div>
            <p class="step-text">
              Se eliminan puntos duplicados y puntos demasiado cercanos para evitar
              singularidades numéricas antes de integrar.
            </p>
            <div class="formula-block">
              <div class="formula-title">Eliminación de duplicados</div>
              <div class="formula-expression">Si |x<sub>i</sub> − x<sub>i−1</sub>| &lt; ε y |y<sub>i</sub> − y<sub>i−1</sub>| &lt; ε, descartar P<sub>i</sub></div>
              <div class="formula-explanation">ε = 1×10<sup>-6</sup>. Se conserva la primera ocurrencia de cada punto único.</div>
            </div>
            <div class="formula-block">
              <div class="formula-title">Eliminación de puntos cercanos</div>
              <div class="formula-expression">Si (x<sub>i</sub> − x<sub>i−1</sub>)² + (y<sub>i</sub> − y<sub>i−1</sub>)² &lt; 1×10<sup>-12</sup>, descartar P<sub>i</sub></div>
              <div class="formula-explanation">Previerte problemas de división entre puntos idénticos.</div>
            </div>
            <div class="step-meta">Puntos tras la limpieza: <span class="mono strong" id="processedPointsCount">0</span></div>
          </div>

          <div class="step">
            <div class="step-index">3</div>
            <div class="step-title">Ordenamiento por coordenada X</div>
            <p class="step-text">
              Se ordenan los puntos por su valor de X para garantizar que x<sub>i</sub> &lt; x<sub>i+1</sub>,
              requisito de la regla del trapecio: la base de cada trapecio debe ser positiva.
            </p>
            <div class="formula-expression">x<sub>0</sub> ≤ x<sub>1</sub> ≤ x<sub>2</sub> ≤ … ≤ x<sub>n−1</sub></div>
          </div>

          <div class="step">
            <div class="step-index">4</div>
            <div class="step-title">Detección de intersecciones con el eje X</div>
            <p class="step-text">
              Para separar las áreas positivas de las negativas, se localizan los puntos
              donde la curva cruza el eje X: un cambio de signo en Y entre vecinos.
            </p>
            <div class="formula-block">
              <div class="formula-title">Condición de intersección</div>
              <div class="formula-expression">y<sub>i</sub> × y<sub>i+1</sub> &lt; 0 &nbsp;⟹&nbsp; hay intersección entre P<sub>i</sub> y P<sub>i+1</sub></div>
              <div class="formula-explanation">Un cambio de signo en los valores Y indica que la curva cruza el eje X.</div>
            </div>
            <div class="formula-block">
              <div class="formula-title">Interpolación lineal de la intersección</div>
              <div class="formula-expression">x<sub>int</sub> = x<sub>i</sub> − y<sub>i</sub> × (x<sub>i+1</sub> − x<sub>i</sub>) / (y<sub>i+1</sub> − y<sub>i</sub>)</div>
              <div class="formula-explanation">Se estima por interpolación lineal el punto exacto donde y = 0.</div>
            </div>
            <div class="step-meta">Intersecciones detectadas: <span class="mono strong" id="intersectionsCount">0</span></div>
          </div>

          <div class="step">
            <div class="step-index">5</div>
            <div class="step-title">Cálculo del área de cada trapecio</div>
            <p class="step-text">
              Para cada par consecutivo P<sub>i</sub>, P<sub>i+1</sub> se forma un trapecio
              con el eje X. El área de cada uno se calcula con la regla del trapecio.
            </p>
            <div class="formula-block accent-curve">
              <div class="formula-title">Fórmula de cada trapecio</div>
              <div class="formula-expression">A<sub>i</sub> = (y<sub>i</sub> + y<sub>i+1</sub>) / 2 × (x<sub>i+1</sub> − x<sub>i</sub>)</div>
              <div class="formula-explanation">
                Si A<sub>i</sub> &gt; 0, el trapecio está por encima del eje X;
                si A<sub>i</sub> &lt; 0, está por debajo.
              </div>
            </div>
            <div class="step-meta">Total de trapecios: <span class="mono strong" id="trapezoidTotalCount">0</span></div>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="integralTitle">
        <div class="section-head">
          <div>
            <h2 class="section-title" id="integralTitle">Resultado integral</h2>
            <p class="section-sub">Cómo se agregan los trapecios individuales en la integral definida.</p>
          </div>
        </div>

        <div class="panel">
          <div class="panel-body">
            <div class="formula-block accent-curve">
              <div class="formula-title">Integral aproximada (suma de trapecios)</div>
              <div class="formula-expression">∫ f(x) dx ≈ Σ A<sub>i</sub> &nbsp;(i = 0 a n−1)</div>
              <div class="formula-explanation">
                La integral definida se aproxima sumando las áreas de todos los trapecios.
                Las áreas bajo el eje X contribuyen negativamente. Esta suma algebraica
                es la <strong>integral firmada</strong>.
              </div>
            </div>
            <div class="formula-block">
              <div class="formula-title">Expansión de la integral firmada</div>
              <div class="formula-expression"><pre>∫ f(x) dx ≈ Σ [(yᵢ + yᵢ₊₁) / 2 × (xᵢ₊₁ − xᵢ)]
  (i = 0 a n−1)</pre></div>
              <div class="formula-explanation">
                Cada término es el área de un trapecio individual; la suma de todos
                los términos da la integral firmada.
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="areasTitle">
        <div class="section-head">
          <div>
            <h2 class="section-title" id="areasTitle">Áreas totales y parciales</h2>
            <p class="section-sub">La diferencia entre el área geométrica y la integral firmada.</p>
          </div>
        </div>

        <div class="panel">
          <div class="panel-body">
            <div class="formula-block">
              <div class="formula-title">Área geométrica total</div>
              <div class="formula-expression">Área<sub>total</sub> = Σ |A<sub>i</sub>| &nbsp;(i = 0 a n−1)</div>
              <div class="formula-explanation">
                El área geométrica considera todas las regiones como positivas,
                sumando el valor absoluto de cada trapecio.
              </div>
            </div>
            <div class="formula-block">
              <div class="formula-title">Área positiva</div>
              <div class="formula-expression">Área<sub>positiva</sub> = Σ max(A<sub>i</sub>, 0)</div>
              <div class="formula-explanation">Suma solo de los trapecios por encima del eje X (A<sub>i</sub> ≥ 0).</div>
            </div>
            <div class="formula-block">
              <div class="formula-title">Área negativa</div>
              <div class="formula-expression">Área<sub>negativa</sub> = Σ min(A<sub>i</sub>, 0)</div>
              <div class="formula-explanation">Suma solo de los trapecios por debajo del eje X (A<sub>i</sub> &lt; 0). El valor es negativo.</div>
            </div>
            <div class="formula-block accent-curve">
              <div class="formula-title">Relación entre áreas</div>
              <div class="formula-expression"><pre>Área<sub>total</sub> = Área<sub>positiva</sub> + |Área<sub>negativa</sub>|
Integral<sub>firmada</sub> = Área<sub>positiva</sub> + Área<sub>negativa</sub></pre></div>
              <div class="formula-explanation">
                La integral firmada puede ser menor que el área total cuando hay regiones negativas.
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="calcTitle">
        <div class="section-head">
          <div>
            <h2 class="section-title" id="calcTitle">Resultados del cálculo</h2>
            <p class="section-sub">Los números finales y el área de cada trapecio individual.</p>
          </div>
        </div>

        <div class="panel">
          <div class="panel-body">
            <div class="readout">
              <div class="readout-cell">
                <div class="readout-bar"></div>
                <div class="readout-label">Integral firmada</div>
                <div class="readout-value" id="resultSignedIntegral">0.0000</div>
              </div>
              <div class="readout-cell total">
                <div class="readout-bar"></div>
                <div class="readout-label">Área geométrica total</div>
                <div class="readout-value" id="resultTotalArea">0.0000</div>
              </div>
              <div class="readout-cell positive">
                <div class="readout-bar"></div>
                <div class="readout-label">Área positiva</div>
                <div class="readout-value" id="resultPositiveArea">0.0000</div>
              </div>
              <div class="readout-cell negative">
                <div class="readout-bar"></div>
                <div class="readout-label">Área negativa</div>
                <div class="readout-value" id="resultNegativeArea">0.0000</div>
              </div>
            </div>

            <div id="trapezoidBreakdown" style="margin-top: 32px;">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 14px;">
                <h3 class="section-title" style="font-size: 18px;">Desglose de trapecios</h3>
                <div class="badge"><span class="dot"></span><span id="trapezoidBreakdownCount">0 trapecios</span></div>
              </div>
              <div class="trapezoid-head">
                <span>Trapecio</span>
                <span>Cálculo</span>
                <span>Área</span>
              </div>
              <div id="trapezoidList" class="trapezoid-scroll">
                <div class="trapezoid-list"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="actions-row">
        <a href="/calculo/" class="btn btn-primary">
          Ver visualización 3D
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
        <a href="/" class="btn btn-ghost">Dibujar nueva curva</a>
      </div>
    </div>
  </div>

  <style>
    .page-head {
      padding: 56px 0 30px;
    }

    .mono.strong {
      color: var(--curve);
      font-weight: 600;
    }

    .formula-block strong {
      color: var(--text-1);
      font-weight: 600;
    }

    .actions-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      padding: 20px 0 8px;
    }

    @media (max-width: 768px) {
      .page-head { padding: 36px 0 24px; }
      .section { margin-bottom: 28px; }
      .section-head { margin-bottom: 18px; }
      .step {
        padding: 20px 18px 20px 62px;
        margin-bottom: 16px;
      }
      .step-index {
        left: 14px;
        top: 20px;
        width: 34px;
        height: 34px;
        font-size: 12.5px;
      }
      .step::before {
        left: 30.5px;
        top: 37px;
        bottom: -53px;
      }
      .step-title { font-size: 17px; }
      .step-meta { margin-top: 14px; }
    }

    @media (max-width: 560px) {
      .trapezoid-head { display: none; }
      .trapezoid-head,
      .trapezoid-item {
        grid-template-columns: 52px minmax(0, 1fr) auto;
        gap: 10px;
      }
      .trapezoid-item {
        padding: 12px 14px;
        font-size: 12px;
      }
    }
  </style>

  <script>
    const resultsData = sessionStorage.getItem('calculusResult');
    const noDataMessage = document.getElementById('noDataMessage');
    const formulaContent = document.getElementById('formulaContent');

    if (!resultsData) {
      noDataMessage.style.display = 'block';
    } else {
      try {
        const data = JSON.parse(resultsData);

        const orig = data.original_points || 0;
        const proc = data.processed_points || [];
        const inter = data.x_axis_intersections || [];
        const trapezoidTotal = Math.max(proc.length - 1, 0);

        document.getElementById('originalPointsCount').textContent = orig;
        document.getElementById('processedPointsCount').textContent = proc.length;
        document.getElementById('intersectionsCount').textContent = inter.length;
        document.getElementById('trapezoidTotalCount').textContent = trapezoidTotal;
        document.getElementById('summaryLine').textContent =
          `${orig} pts → ${proc.length} pts · ${inter.length} cruces · ${trapezoidTotal} trapecios`;
        document.getElementById('trapezoidBreakdownCount').textContent =
          `${trapezoidTotal} trapecios`;

        document.getElementById('resultSignedIntegral').textContent = data.signed_integral.toFixed(4);
        document.getElementById('resultTotalArea').textContent = data.total_geometric_area.toFixed(4);
        document.getElementById('resultPositiveArea').textContent = data.positive_area.toFixed(4);
        document.getElementById('resultNegativeArea').textContent = data.negative_area.toFixed(4);

        const trapezoidList = document.querySelector('#trapezoidList .trapezoid-list');

        for (let i = 0; i < proc.length - 1; i++) {
          const p1 = proc[i];
          const p2 = proc[i + 1];
          const area = ((p1.y + p2.y) / 2) * (p2.x - p1.x);
          const isPositive = area >= 0;
          const signClass = isPositive ? 'positive' : 'negative';
          const signText = isPositive ? '+' : '−';

          const div = document.createElement('div');
          div.className = `trapezoid-item ${signClass}`;
          div.innerHTML = `
            <span class="trap-index">A<sub>${i}</sub></span>
            <span class="trap-formula">(${p1.y.toFixed(2)} + ${p2.y.toFixed(2)}) / 2 × (${p2.x.toFixed(2)} − ${p1.x.toFixed(2)})</span>
            <span class="trap-value">${signText}${Math.abs(area).toFixed(4)}</span>
          `;
          trapezoidList.appendChild(div);
        }
      } catch (e) {
        console.error('Error parsing results:', e);
        noDataMessage.style.display = 'block';
        formulaContent.style.display = 'none';
      }
    }
  </script>
</Layout>
