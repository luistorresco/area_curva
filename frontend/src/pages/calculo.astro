---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Cálculo 3D — CalculusWeb">
  <div class="container">
    <header class="page-head">
      <div>
        <h1 class="page-title">La integral, en volumen</h1>
        <p class="page-lede mt-3">
          La curva dibujada y cada trapecio que aproxima el área, levantados del plano
          y expuestos en tres dimensiones. Gira, acerca y alterna la malla para inspeccionar cada rebanada.
        </p>
      </div>
    </header>

    <div id="errorMessage" class="hidden my-4"></div>

    <div class="panel">
      <div class="panel-header">
        <h2 class="section-title">Visualización 3D</h2>
        <div class="badge"><span class="dot"></span><span id="trapecioCount">Trapecios: 0</span></div>
      </div>
      <div class="panel-body flush">
        <div id="threeContainer" class="three-container"></div>
      </div>
    </div>

    <div class="toolbar" role="toolbar" aria-label="Controles de visualización 3D">
      <button id="replayBtn" class="btn btn-primary">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 0 1 2.91-6.36L12 2l6.09 3.64A9 9 0 0 1 21 12"></path>
        </svg>
        Reproducir animación
      </button>
      <button id="rotateBtn" class="btn btn-ghost">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 11-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path>
          <path d="M21 3v5h-5"></path>
        </svg>
        Rotar automáticamente
      </button>
      <button id="resetViewBtn" class="btn btn-ghost">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
        </svg>
        Restablecer vista
      </button>
      <button id="toggleWireframeBtn" class="btn btn-ghost">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <path d="M3 9h18M3 15h18M9 3v18M15 3v18"></path>
        </svg>
        Alternar malla
      </button>
    </div>

    <div class="info-strip">
      <p>
        La curva aparece en cian; los trapecios por encima del eje X, en violeta;
        los que quedan por debajo, en rosa. El eje X es horizontal, la altura es Y
        y la profundidad extiende cada rebanada hacia el observador.
      </p>
    </div>
  </div>


  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
        "three/examples/jsm/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
      }
    }
  </script>

  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

    const threeContainer = document.getElementById('threeContainer');
    const errorMessage = document.getElementById('errorMessage');
    const trapecioCount = document.getElementById('trapecioCount');
    const replayBtn = document.getElementById('replayBtn');
    const rotateBtn = document.getElementById('rotateBtn');
    const resetViewBtn = document.getElementById('resetViewBtn');
    const toggleWireframeBtn = document.getElementById('toggleWireframeBtn');

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function readHexVar(name, fallback) {
      const value = getComputedStyle(document.documentElement)
        .getPropertyValue(name)
        .trim();

      if (!value) return fallback;
      if (value.startsWith('#')) return parseInt(value.slice(1), 16);

      const rgb = value.match(/\d+/g);
      if (!rgb || rgb.length < 3) return fallback;
      return (Number(rgb[0]) << 16) | (Number(rgb[1]) << 8) | Number(rgb[2]);
    }

    function getScenePalette() {
      return {
        bg: readHexVar('--scene-bg', 0x060913),
        fog: readHexVar('--scene-fog', 0x060913),
        gridMajor: readHexVar('--scene-grid-major', 0x2b3a66),
        gridMinor: readHexVar('--scene-grid-minor', 0x141d3a),
        curve: readHexVar('--scene-curve', 0x2dd4ee),
        areaPos: readHexVar('--scene-pos', 0x9d7bff),
        areaNeg: readHexVar('--scene-neg', 0xff6b8b),
        dust: readHexVar('--scene-dust', 0x9db1e8),
        ambient: readHexVar('--scene-ambient', 0x9db1e8)
      };
    }

    let scene, camera, renderer, controls;
    let ambient, grid, cyanGlow, violetGlow;
    let curveLine, curveGlow, curvePointsGroup, trapezoidGroup, dust;
    let wireframeEnabled = false;
    let revealT = 0;
    let revealing = false;
    const REVEAL_DURATION = 2.2;

    function makeGlowTexture() {
      const c = document.createElement('canvas');
      c.width = c.height = 64;
      const g = c.getContext('2d');
      const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, 'rgba(255,255,255,1)');
      grad.addColorStop(0.4, 'rgba(255,255,255,0.35)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = grad;
      g.fillRect(0, 0, 64, 64);
      return new THREE.CanvasTexture(c);
    }

    function createGrid(palette) {
      if (grid) {
        scene.remove(grid);
        grid.geometry.dispose();
        grid.material.dispose();
      }
      grid = new THREE.GridHelper(70, 70, palette.gridMajor, palette.gridMinor);
      grid.material.transparent = true;
      grid.material.opacity = 0.55;
      scene.add(grid);
    }

    function applySceneTheme() {
      if (!scene) return;
      const palette = getScenePalette();
      scene.background.set(palette.bg);
      scene.fog.color.set(palette.fog);

      createGrid(palette);

      if (ambient) ambient.color.set(palette.ambient);
      if (cyanGlow) cyanGlow.color.set(palette.curve);
      if (violetGlow) violetGlow.color.set(palette.areaPos);
      if (curveLine) curveLine.material.color.set(palette.curve);
      if (curveGlow) curveGlow.material.color.set(palette.curve);
      if (dust) dust.material.color.set(palette.dust);

      curvePointsGroup?.children.forEach((sphere) => {
        sphere.material.color.set(palette.curve);
        sphere.material.emissive.set(palette.curve);
      });

      trapezoidGroup?.children.forEach((mesh) => {
        const color = mesh.userData.positive ? palette.areaPos : palette.areaNeg;
        mesh.material.color.set(color);
        mesh.material.emissive.set(color);
      });

      if (renderer && camera) renderer.render(scene, camera);
    }

    function initScene() {
      const palette = getScenePalette();
      scene = new THREE.Scene();
      scene.background = new THREE.Color(palette.bg);
      scene.fog = new THREE.Fog(palette.fog, 34, 90);

      const width = threeContainer.clientWidth;
      const height = threeContainer.clientHeight;

      camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 300);
      camera.position.set(17, 13, 22);

      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(width, height);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.1;
      threeContainer.appendChild(renderer.domElement);

      ambient = new THREE.AmbientLight(palette.ambient, 0.5);
      scene.add(ambient);

      const key = new THREE.DirectionalLight(0xffffff, 1.1);
      key.position.set(14, 24, 16);
      scene.add(key);

      cyanGlow = new THREE.PointLight(palette.curve, 22, 40);
      cyanGlow.position.set(0, 6, 4);
      scene.add(cyanGlow);

      violetGlow = new THREE.PointLight(palette.areaPos, 14, 40);
      violetGlow.position.set(0, -4, -6);
      scene.add(violetGlow);

      createGrid(palette);

      const axes = new THREE.AxesHelper(12);
      axes.material.transparent = true;
      axes.material.opacity = 0.6;
      scene.add(axes);

      controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.screenSpacePanning = false;
      controls.minDistance = 6;
      controls.maxDistance = 70;
      controls.maxPolarAngle = Math.PI * 0.52;
      controls.autoRotateSpeed = 0.9;

      trapezoidGroup = new THREE.Group();
      scene.add(trapezoidGroup);

      curvePointsGroup = new THREE.Group();
      scene.add(curvePointsGroup);

      // floating dust for depth
      const count = 180;
      const positions = new Float32Array(count * 3);
      const speeds = new Float32Array(count);
      for (let i = 0; i < count; i++) {
        positions[i * 3] = (Math.random() - 0.5) * 60;
        positions[i * 3 + 1] = Math.random() * 24 - 4;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 40;
        speeds[i] = 0.1 + Math.random() * 0.25;
      }
      const dustGeo = new THREE.BufferGeometry();
      dustGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      dust = new THREE.Points(
        dustGeo,
        new THREE.PointsMaterial({
          size: 0.14,
          map: makeGlowTexture(),
          color: palette.dust,
          transparent: true,
          opacity: 0.35,
          depthWrite: false,
          blending: THREE.AdditiveBlending
        })
      );
      dust.userData = { speeds };
      scene.add(dust);

      const clock = new THREE.Clock();

      function animate() {
        requestAnimationFrame(animate);
        const delta = Math.min(clock.getDelta(), 0.05);
        const elapsed = clock.getElapsedTime();

        if (revealing) {
          revealT += delta;
          updateReveal(elapsed);
          if (revealT >= REVEAL_DURATION) {
            revealing = false;
            finalizeReveal();
          }
        }

        if (dust) {
          const pos = dust.geometry.attributes.position;
          const speeds = dust.userData.speeds;
          for (let i = 0; i < speeds.length; i++) {
            let y = pos.getY(i) + speeds[i] * delta;
            if (y > 22) y = -4;
            pos.setY(i, y);
          }
          pos.needsUpdate = true;
        }

        controls.update();
        renderer.render(scene, camera);
      }

      animate();
    }

    function clearGroup(group) {
      if (!group) return;
      while (group.children.length > 0) {
        const child = group.children[0];
        child.traverse((obj) => {
          if (obj.geometry) obj.geometry.dispose();
          if (obj.material) {
            if (Array.isArray(obj.material)) obj.material.forEach((m) => m.dispose());
            else obj.material.dispose();
          }
        });
        group.remove(child);
      }
    }

    function createCurveLine(points) {
      const colors = getScenePalette();
      clearGroup(curvePointsGroup);
      if (curveLine) {
        curveLine.geometry.dispose();
        curveLine.material.dispose();
        scene.remove(curveLine);
      }
      if (curveGlow) {
        curveGlow.geometry.dispose();
        curveGlow.material.dispose();
        scene.remove(curveGlow);
      }

      const curvePoints = points.map((p) => new THREE.Vector3(p.x, p.y, -1.5));

      const geometry = new THREE.BufferGeometry().setFromPoints(curvePoints);
      geometry.setDrawRange(0, reducedMotion ? Infinity : 0);

      curveLine = new THREE.Line(
        geometry,
        new THREE.LineBasicMaterial({ color: colors.curve, transparent: true, opacity: 0.95 })
      );
      scene.add(curveLine);

      // additive halo of points along the curve — a soft phosphor glow
      const glowGeo = new THREE.BufferGeometry().setFromPoints(curvePoints);
      curveGlow = new THREE.Points(
        glowGeo,
        new THREE.PointsMaterial({
          size: 0.34,
          map: makeGlowTexture(),
          color: colors.curve,
          transparent: true,
          opacity: 0.5,
          depthWrite: false,
          blending: THREE.AdditiveBlending
        })
      );
      curveGlow.geometry.setDrawRange(0, reducedMotion ? Infinity : 0);
      scene.add(curveGlow);

      // vertex markers, scaled to zero, popped in during the reveal
      const sphereGeo = new THREE.SphereGeometry(0.16, 14, 14);
      const sphereMat = new THREE.MeshStandardMaterial({
        color: colors.curve,
        emissive: colors.curve,
        emissiveIntensity: 0.55,
        roughness: 0.3,
        metalness: 0.1
      });

      points.forEach((p, i) => {
        const sphere = new THREE.Mesh(sphereGeo, sphereMat);
        sphere.position.set(p.x, p.y, -1.5);
        sphere.userData = { delay: 0.25 + (i / points.length) * 1.1, index: i };
        sphere.scale.setScalar(reducedMotion ? 1 : 0);
        curvePointsGroup.add(sphere);
      });
    }

    function createTrapezoids(points) {
      const colors = getScenePalette();
      clearGroup(trapezoidGroup);

      const depth = 3;

      for (let i = 0; i < points.length - 1; i++) {
        const p1 = points[i];
        const p2 = points[i + 1];

        const isPositive = (p1.y + p2.y) / 2 >= 0;
        const color = isPositive ? colors.areaPos : colors.areaNeg;

        const vertices = new Float32Array([
          p1.x, p1.y, -depth / 2,
          p2.x, p2.y, -depth / 2,
          p2.x, p2.y, depth / 2,
          p1.x, p1.y, depth / 2,
          p1.x, 0, -depth / 2,
          p2.x, 0, -depth / 2,
          p2.x, 0, depth / 2,
          p1.x, 0, depth / 2
        ]);

        const indices = new Uint32Array([
          0, 1, 2, 0, 2, 3,
          4, 5, 6, 4, 6, 7,
          0, 3, 7, 0, 7, 4,
          1, 5, 6, 1, 6, 2,
          3, 2, 6, 3, 6, 7,
          0, 4, 5, 0, 5, 1
        ]);

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(vertices, 3));
        geometry.setIndex(new THREE.BufferAttribute(indices, 1));
        geometry.computeVertexNormals();

        const material = new THREE.MeshStandardMaterial({
          color,
          emissive: color,
          emissiveIntensity: 0.18,
          transparent: true,
          opacity: 0.5,
          side: THREE.DoubleSide,
          wireframe: wireframeEnabled,
          depthWrite: false,
          roughness: 0.4,
          metalness: 0.05
        });

        const mesh = new THREE.Mesh(geometry, material);
        mesh.renderOrder = 1;
        mesh.userData = { delay: 0.55 + i * 0.05, index: i, positive: isPositive };
        mesh.scale.y = reducedMotion ? 1 : 0;
        trapezoidGroup.add(mesh);
      }
    }

    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
    const easeOutBack = (t) => {
      const c1 = 1.70158;
      const c3 = c1 + 1;
      return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
    };

    function updateReveal(elapsed) {
      const t = revealT;

      // curve draws itself progressively
      if (curveLine && curveLine.geometry) {
        const total = curveLine.geometry.attributes.position.count;
        const drawn = Math.floor(easeOutCubic(Math.min(t / 1.4, 1)) * total);
        curveLine.geometry.setDrawRange(0, drawn);
        curveGlow.geometry.setDrawRange(0, drawn);
      }

      // vertex markers pop in
      curvePointsGroup.children.forEach((sphere) => {
        const local = Math.min(Math.max((t - sphere.userData.delay) / 0.5, 0), 1);
        sphere.scale.setScalar(easeOutBack(local));
      });

      // trapezoids rise from the plane, staggered
      trapezoidGroup.children.forEach((mesh) => {
        const local = Math.min(Math.max((t - mesh.userData.delay) / 0.8, 0), 1);
        mesh.scale.y = easeOutCubic(local);
      });
    }

    function finalizeReveal() {
      if (curveLine) curveLine.geometry.setDrawRange(0, Infinity);
      if (curveGlow) curveGlow.geometry.setDrawRange(0, Infinity);
      curvePointsGroup.children.forEach((s) => s.scale.setScalar(1));
      trapezoidGroup.children.forEach((m) => { m.scale.y = 1; });
    }

    function startReveal() {
      if (reducedMotion) return;
      revealT = 0;
      revealing = true;
    }

    function showError(msg) {
      errorMessage.style.display = 'flex';
      errorMessage.className = 'error-message';
      errorMessage.innerHTML = `
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>${msg}</span>
      `;
    }

    function loadData() {
      const resultsData = sessionStorage.getItem('calculusResult');

      if (!resultsData) {
        showError(`No hay datos de cálculo disponibles. <a href="/">Dibujar una curva</a>`);
        return;
      }

      try {
        const data = JSON.parse(resultsData);

        let points = data.processed_points || [];
        if (!points.length && data.points) points = data.points;

        const sessionPoints = sessionStorage.getItem('drawnPoints');
        if (!points.length && sessionPoints) points = JSON.parse(sessionPoints);

        if (!points.length || points.length < 2) {
          showError(`Necesitas dibujar una curva primero. <a href="/">Dibujar curva</a>`);
          return;
        }

        errorMessage.style.display = 'none';

        createCurveLine(points);
        createTrapezoids(points);
        trapecioCount.textContent = `Trapecios: ${points.length - 1}`;

        startReveal();
      } catch (e) {
        console.error('Error parsing results:', e);
        showError(`Error al cargar los datos: ${e.message}`);
      }
    }

    function toggleWireframe() {
      wireframeEnabled = !wireframeEnabled;
      trapezoidGroup.traverse((child) => {
        if (child.material) {
          child.material.wireframe = wireframeEnabled;
          child.material.needsUpdate = true;
        }
      });
      toggleWireframeBtn.childNodes[toggleWireframeBtn.childNodes.length - 1].textContent =
        wireframeEnabled ? ' Ocultar malla' : ' Alternar malla';
    }

    function resetView() {
      camera.position.set(17, 13, 22);
      controls.target.set(0, 0, 0);
      controls.update();
    }

    replayBtn.addEventListener('click', startReveal);

    rotateBtn.addEventListener('click', () => {
      controls.autoRotate = !controls.autoRotate;
      const label = rotateBtn.childNodes[rotateBtn.childNodes.length - 1];
      label.textContent = controls.autoRotate ? ' Detener rotación' : ' Rotar automáticamente';
    });

    resetViewBtn.addEventListener('click', resetView);
    toggleWireframeBtn.addEventListener('click', toggleWireframe);

    window.addEventListener('resize', () => {
      const width = threeContainer.clientWidth;
      const height = threeContainer.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    }, { passive: true });

    initScene();
    loadData();
    window.addEventListener('themechange', applySceneTheme);
  </script>
</Layout>
