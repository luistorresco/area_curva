---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Cálculo 3D - CalculusApp">
  <div class="container">
    <header style="padding: 24px 0; text-align: center;">
      <h1 style="font-size: 28px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">
        Visualización 3D del cálculo
      </h1>
      <p style="color: var(--text-secondary); font-size: 16px;">Representación tridimensional de la curva y los trapecios bajo la curva</p>
    </header>

  <div id="errorMessage" style="display: none; margin: 16px 0;"></div>

    <div class="card" style="margin-bottom: 24px;">
      <div class="card-header">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <h2 style="font-size: 18px; font-weight: 600; color: var(--text-primary);">Visualización 3D</h2>
          <div class="info-badge" id="trapecioCount">Trapecios: 0</div>
        </div>
      </div>
      <div class="card-body" style="padding: 0;">
        <div id="threeContainer" style="width: 100%; height: 500px; position: relative;"></div>
      </div>
    </div>

    <div class="toolbar" role="toolbar" aria-label="Controles de visualización 3D">
      <button id="rotateBtn" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
        Rotar automáticamente
      </button>
      <button id="resetViewBtn" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 0 1 2.91-6.36L12 2l6.09 3.64A9 9 0 0 1 21 12"></path>
        </svg>
        Restablecer vista
      </button>
      <button id="toggleWireframeBtn" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        </svg>
        Alternar malla
      </button>
    </div>

    <div id="vizInfo" style="margin-top: 16px; padding: 16px; background: var(--background); border-radius: var(--radius-sm); border: 1px solid var(--border);">
      <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.6;">
        Esta visualización muestra la curva dibujada (línea azul) y los trapecios utilizados para aproximar el área bajo la curva (superficies moradas).
        Usa el mouse para rotar, hacer zoom y desplazar la vista. El eje X está en horizontal, el eje Y (altura) en vertical, y el eje Z (profundidad) extiende los trapecios hacia ti.
      </p>
    </div>
  </div>

  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
        "three/examples/jsm/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
      }
    }
  </script>

  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

    const threeContainer = document.getElementById('threeContainer');
    const errorMessage = document.getElementById('errorMessage');
    const trapecioCount = document.getElementById('trapecioCount');
    const rotateBtn = document.getElementById('rotateBtn');
    const resetViewBtn = document.getElementById('resetViewBtn');
    const toggleWireframeBtn = document.getElementById('toggleWireframeBtn');

    let scene, camera, renderer, controls;
    let curveLine, trapezoidGroup;
    let isAnimating = false;
    let wireframeEnabled = false;

    function initScene() {
      scene = new THREE.Scene();
      scene.background = new THREE.Color(0xf8fafc);

      const width = threeContainer.clientWidth;
      const height = threeContainer.clientHeight;

      camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      camera.position.set(15, 12, 20);

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(window.devicePixelRatio || 1);
      threeContainer.appendChild(renderer.domElement);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
      scene.add(ambientLight);

      const directionalLight = new THREE.DirectionalLight(0xffffff, 0.6);
      directionalLight.position.set(10, 20, 15);
      directionalLight.castShadow = true;
      directionalLight.shadow.camera.top = 50;
      directionalLight.shadow.camera.bottom = -50;
      directionalLight.shadow.camera.left = -50;
      directionalLight.shadow.camera.right = 50;
      directionalLight.shadow.camera.near = 0.1;
      directionalLight.shadow.camera.far = 100;
      directionalLight.shadow.mapSize.set(1024, 1024);
      scene.add(directionalLight);

      const gridHelper = new THREE.GridHelper(60, 60, 0xe2e8f0, 0xf1f5f9);
      gridHelper.position.y = -0.01;
      scene.add(gridHelper);

      const axesHelper = new THREE.AxesHelper(10);
      scene.add(axesHelper);

      controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;
      controls.screenSpacePanning = false;
      controls.minDistance = 5;
      controls.maxDistance = 80;
      controls.maxPolarAngle = Math.PI;

      trapezoidGroup = new THREE.Group();
      scene.add(trapezoidGroup);

      animate();
    }

    function animate() {
      requestAnimationFrame(animate);

      if (isAnimating && trapezoidGroup && curveLine) {
        const time = Date.now() * 0.001;
        const radius = 25;
        camera.position.x = Math.cos(time * 0.2) * radius;
        camera.position.z = Math.sin(time * 0.2) * radius;
        camera.position.y = 12 + Math.sin(time * 0.1) * 3;
        camera.lookAt(0, 0, 0);
      }

      if (controls) {
        controls.update();
      }

      if (renderer && scene && camera) {
        renderer.render(scene, camera);
      }
    }

    function createCurveLine(points) {
      if (curveLine) {
        curveLine.geometry.dispose();
        scene.remove(curveLine);
      }

      const curvePoints = [];
      const spacing = 3;

      for (let i = 0; i < points.length; i++) {
        const p = points[i];
        curvePoints.push(new THREE.Vector3(p.x, p.y, -spacing / 2));
      }

      const geometry = new THREE.BufferGeometry().setFromPoints(curvePoints);
      const material = new THREE.LineBasicMaterial({ color: 0x6366f1, linewidth: 3 });
      const line = new THREE.Line(geometry, material);
      scene.add(line);
      curveLine = line;

      for (let i = 0; i < points.length; i++) {
        const p = points[i];
        const sphereGeometry = new THREE.SphereGeometry(0.15, 12, 12);
        const sphereMaterial = new THREE.MeshStandardMaterial({ color: 0x6366f1 });
        const sphere = new THREE.Mesh(sphereGeometry, sphereMaterial);
        sphere.position.set(p.x, p.y, -spacing / 2);
        sphere.castShadow = true;
        sphere.receiveShadow = true;
        scene.add(sphere);
      }
    }

    function createTrapezoids(points) {
      if (trapezoidGroup) {
        while (trapezoidGroup.children.length > 0) {
          const child = trapezoidGroup.children[0];
          child.geometry.dispose();
          if (child.material) child.material.dispose();
          trapezoidGroup.remove(child);
        }
      }

      const spacing = 3;
      const depth = spacing;

      for (let i = 0; i < points.length - 1; i++) {
        const p1 = points[i];
        const p2 = points[i + 1];

        const isPositive = (p1.y + p2.y) / 2 >= 0;
        const color = isPositive ? 0x8b5cf6 : 0xef4444;

        const vertices = new Float32Array([
          p1.x, p1.y, -depth / 2,
          p2.x, p2.y, -depth / 2,
          p2.x, p2.y, depth / 2,
          p1.x, p1.y, depth / 2,
          p1.x, 0, -depth / 2,
          p2.x, 0, -depth / 2,
          p2.x, 0, depth / 2,
          p1.x, 0, depth / 2
        ]);

        const indices = new Uint32Array([
          0, 1, 2, 0, 2, 3,
          4, 5, 6, 4, 6, 7,
          0, 3, 7, 0, 7, 4,
          1, 5, 6, 1, 6, 2,
          3, 2, 6, 3, 6, 7,
          0, 4, 5, 0, 5, 1
        ]);

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(vertices, 3));
        geometry.setIndex(new THREE.BufferAttribute(indices, 1));
        geometry.computeVertexNormals();

        const material = new THREE.MeshStandardMaterial({
          color: color,
          transparent: true,
          opacity: 0.6,
          side: THREE.DoubleSide,
          wireframe: wireframeEnabled,
          depthWrite: false,
        });

        const mesh = new THREE.Mesh(geometry, material);
        mesh.renderOrder = 1;
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        trapezoidGroup.add(mesh);
      }
    }

    function loadData() {
      const resultsData = sessionStorage.getItem('calculusResult');

      if (!resultsData) {
        errorMessage.style.display = 'flex';
        errorMessage.innerHTML = `
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          No hay datos de cálculo disponibles. <a href="/" class="btn btn-secondary" style="display: inline-block; margin-left: 8px; padding: 4px 12px; font-size: 12px;">Ir al Home</a>
        `;
        return;
      }

      try {
        const data = JSON.parse(resultsData);

        let points = data.processed_points || [];
        if (!points.length && data.points) {
          points = data.points;
        }

        const sessionPoints = sessionStorage.getItem('drawnPoints');
        if (!points.length && sessionPoints) {
          points = JSON.parse(sessionPoints);
        }

        if (!points.length || points.length < 2) {
          errorMessage.style.display = 'flex';
          errorMessage.innerHTML = `
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            Necesitas dibujar una curva primero. <a href="/" class="btn btn-secondary" style="display: inline-block; margin-left: 8px; padding: 4px 12px; font-size: 12px;">Dibujar curva</a>
          `;
          return;
        }

        errorMessage.style.display = 'none';

        createCurveLine(points);
        createTrapezoids(points);
        trapecioCount.textContent = `Trapecios: ${points.length - 1}`;
      } catch (e) {
        console.error('Error parsing results:', e);
        errorMessage.style.display = 'flex';
        errorMessage.innerHTML = `
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          Error al cargar los datos: ${e.message}
        `;
      }
    }

    function toggleWireframe() {
      wireframeEnabled = !wireframeEnabled;
      trapezoidGroup.traverse(function (child) {
        if (child.material) {
          child.material.wireframe = wireframeEnabled;
          child.material.needsUpdate = true;
        }
      });
      toggleWireframeBtn.textContent = wireframeEnabled ? 'Ocultar malla' : 'Alternar malla';
    }

    function resetView() {
      camera.position.set(15, 12, 20);
      controls.target.set(0, 0, 0);
      controls.update();
    }

    rotateBtn.addEventListener('click', function () {
      isAnimating = !isAnimating;
      rotateBtn.textContent = isAnimating ? 'Detener rotación' : 'Rotar automáticamente';
    });

    resetViewBtn.addEventListener('click', resetView);
    toggleWireframeBtn.addEventListener('click', toggleWireframe);

    window.addEventListener('resize', function () {
      const width = threeContainer.clientWidth;
      const height = threeContainer.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });

    initScene();
    loadData();
  </script>
</Layout>