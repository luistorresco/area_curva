---
import Layout from '../layouts/Layout.astro';
---
<Layout title="CalculusWeb — Cálculo bajo la curva">
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div id="heroScene" class="hero-scene" aria-hidden="true"></div>
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-rule">
        <span class="mono">∫ f(x) dx</span>
        <span class="rule-line"></span>
        <span class="mono">regla del trapecio</span>
      </div>
      <h1 class="hero-title">Dibuja la curva.<br />Mide el área.</h1>
      <p class="hero-lede">
        Traza una función con el mouse, el dedo o el trackpad, o escribe
        f(x) directamente y la graficamos por ti. CalculusWeb la convierte
        en una integral definida: calcula el área firmada, las áreas positiva y negativa,
        y el área geométrica total — y la exhibe en tres dimensiones.
      </p>
      <div class="hero-actions">
        <a href="#instrumento" class="btn btn-primary">
          Empezar a dibujar
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
        </a>
        <a href="/calculo/" class="btn btn-ghost">Ver en tres dimensiones</a>
      </div>
    </div>
  </section>

  <!-- ============ INSTRUMENTO ============ -->
  <div class="container" id="instrumento">
    <div class="instrument-head">
      <h2 class="section-title">Plano cartesiano</h2>
      <div class="badge"><span class="dot"></span><span id="pointCount">Puntos: 0</span></div>
    </div>

    <div class="mode-toggle" role="tablist" aria-label="Modo de entrada">
      <button class="mode-btn active" id="modeDraw" role="tab" aria-selected="true">
        <svg viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
        Dibujar a mano
      </button>
      <button class="mode-btn" id="modeFunc" role="tab" aria-selected="false">
        <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
        Función f(x)
      </button>
    </div>

    <div id="functionPanel" class="hidden">
      <div class="panel mb-4">
        <div class="panel-body">
          <label class="field-label" for="funcInput">Función a graficar</label>
          <div class="func-input-row">
            <span class="func-prefix mono">f(x) =</span>
            <input id="funcInput" class="func-input mono" type="text" placeholder="sin(x) * exp(-0.2 * x)" spellcheck="false" autocomplete="off" autocapitalize="off" />
          </div>
          <p id="recognizedHint" class="field-help hidden"></p>
          <div class="func-range-row">
            <div class="func-field">
              <label class="field-label" for="rangeStart">Intervalo desde</label>
              <input id="rangeStart" class="func-input mono" type="number" step="any" value="-5" />
            </div>
            <div class="func-field">
              <label class="field-label" for="rangeEnd">hasta</label>
              <input id="rangeEnd" class="func-input mono" type="number" step="any" value="5" />
            </div>
            <div class="func-field func-samples">
              <label class="field-label" for="samplesInput">Muestras</label>
              <input id="samplesInput" class="func-input mono" type="number" min="20" max="2000" step="20" value="240" />
            </div>
            <button id="plotFuncBtn" class="btn btn-primary">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
              Graficar y calcular
            </button>
          </div>
          <div class="func-hints">
            <span class="hint-label">Ejemplos:</span>
            <button class="hint-chip mono" data-expr="x**2 - 4">x² − 4</button>
            <button class="hint-chip mono" data-expr="sin(x)">sin(x)</button>
            <button class="hint-chip mono" data-expr="exp(-0.3*x) * cos(3*x)">e^−0.3x·cos(3x)</button>
            <button class="hint-chip mono" data-expr="sqrt(abs(x))">√|x|</button>
            <button class="hint-chip mono" data-expr="1 / (1 + exp(-x))">sigmoide</button>
          </div>
          <p class="func-note mono">Operadores: + − * / ** ^ · Funciones: sin cos tan asin acos atan atan2 sqrt cbrt abs exp log log10 log2 sinh cosh tanh floor ceil factorial · Constantes: pi e tau<br />La integral es una aproximación por trapecios. Más muestras reducen el error, pero no lo eliminan.</p>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="canvas-frame">
        <canvas id="canvas" class="block w-full touch-none"></canvas>
        <div class="coord-readout mono" id="coordReadout" aria-hidden="true">x: 0.00&nbsp;&nbsp;y: 0.00</div>
      </div>
    </div>

    <div id="errorMessage" class="hidden mt-4"></div>

    <div class="toolbar" role="toolbar" aria-label="Controles de cálculo">
      <button id="calculateBtn" class="btn btn-primary" disabled>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        Calcular área
      </button>
      <button id="validateBtn" class="btn btn-ghost draw-only" type="button" disabled>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6L9 17l-5-5"></path>
        </svg>
        Validar dibujo
      </button>
      <button id="recognizeBtn" class="btn btn-ghost draw-only" type="button" disabled>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3v3m0 12v3M3 12h3m12 0h3"></path>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
        Encontrar f(x)
      </button>
      <button id="clearBtn" class="btn btn-ghost" disabled>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
        Limpiar
      </button>
      <a href="/curvas/" class="btn btn-ghost">Área entre curvas</a>
    </div>

    <div id="drawAnalysisPanel" class="panel mt-6 hidden" aria-live="polite">
      <div class="panel-header">
        <h2 class="section-title">Análisis del dibujo</h2>
        <span id="analysisBadge" class="badge"><span id="analysisBadgeText">Sin analizar</span></span>
      </div>
      <div class="panel-body">
        <div id="validationReport" class="analysis-report"></div>
        <div id="recognitionBox" class="analysis-recognition hidden">
          <div class="analysis-subhead">
            <h3 class="section-title text-lg">Funciones candidatas</h3>
            <button id="closeRecognitionBtn" class="btn btn-ghost btn-sm" type="button">Cerrar</button>
          </div>
          <div id="recognitionNote" class="field-help"></div>
          <div id="candidateList" class="candidate-list"></div>
        </div>
      </div>
    </div>

    <div id="loadingIndicator" class="hidden mt-5">
      <div class="progress-bar"><div class="progress-bar-fill"></div></div>
      <p class="loading-note">Calculando la integral…</p>
    </div>

    <div id="resultsSummary" class="hidden mt-7">
      <div class="readout" role="region" aria-label="Resultados del cálculo">
        <div class="readout-cell">
          <div class="readout-bar"></div>
          <div class="readout-label">Integral firmada</div>
          <div class="readout-value" id="signedIntegral">0.0000</div>
        </div>
        <div class="readout-cell total">
          <div class="readout-bar"></div>
          <div class="readout-label">Área geométrica total</div>
          <div class="readout-value" id="totalArea">0.0000</div>
        </div>
        <div class="readout-cell positive">
          <div class="readout-bar"></div>
          <div class="readout-label">Área positiva</div>
          <div class="readout-value" id="positiveArea">0.0000</div>
        </div>
        <div class="readout-cell negative">
          <div class="readout-bar"></div>
          <div class="readout-label">Área negativa</div>
          <div class="readout-value" id="negativeArea">0.0000</div>
        </div>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap gap-3" id="resultsActions" style="display: none;">
      <a href="/results/" class="btn btn-ghost">Ver detalles y fórmulas</a>
      <a href="/calculo/" class="btn btn-ghost">Explorar en 3D</a>
    </div>
  </div>


  <!-- ============ HERO THREE.JS SCENE ============ -->
  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js"
      }
    }
  </script>

  <script type="module">
    const heroEl = document.getElementById('heroScene');
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let THREE;

    function readHexVar(name, fallback) {
      const value = getComputedStyle(document.documentElement)
        .getPropertyValue(name)
        .trim();

      if (!value) return fallback;
      if (value.startsWith('#')) return parseInt(value.slice(1), 16);

      const rgb = value.match(/\d+/g);
      if (!rgb || rgb.length < 3) return fallback;
      return (Number(rgb[0]) << 16) | (Number(rgb[1]) << 8) | Number(rgb[2]);
    }

    function getScenePalette() {
      return {
        bg: readHexVar('--scene-bg', 0x060913),
        fog: readHexVar('--scene-fog', 0x060913),
        gridMajor: readHexVar('--scene-grid-major', 0x2b3a66),
        gridMinor: readHexVar('--scene-grid-minor', 0x141d3a),
        curve: readHexVar('--scene-curve', 0x2dd4ee),
        pos: readHexVar('--scene-pos', 0x9d7bff),
        neg: readHexVar('--scene-neg', 0xff6b8b),
        dust: readHexVar('--scene-dust', 0x2dd4ee)
      };
    }

    function curveFn(x) {
      return 2.1 * Math.sin(x * 0.55) + 0.75 * Math.sin(x * 1.35 + 1.7) + 0.35 * Math.cos(x * 2.1);
    }

    const CURVE_RANGE = 15;
    const SAMPLES = 140;

    function buildCurvePoints() {
      const pts = [];
      for (let i = 0; i <= SAMPLES; i++) {
        const x = -CURVE_RANGE + (2 * CURVE_RANGE * i) / SAMPLES;
        pts.push(new THREE.Vector3(x, curveFn(x), 0));
      }
      return pts;
    }

    function buildRibbon(pts, width) {
      const verts = new Float32Array((pts.length) * 2 * 3);
      const idx = [];
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        verts[i * 6 + 0] = p.x; verts[i * 6 + 1] = p.y; verts[i * 6 + 2] = -width / 2;
        verts[i * 6 + 3] = p.x; verts[i * 6 + 4] = p.y; verts[i * 6 + 5] = width / 2;
        if (i < pts.length - 1) {
          const a = i * 2;
          idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
        }
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(verts, 3));
      geo.setIndex(idx);
      geo.computeVertexNormals();
      return geo;
    }

    function buildSlab(p1, p2, depth) {
      const vertices = new Float32Array([
        p1.x, p1.y, -depth / 2,
        p2.x, p2.y, -depth / 2,
        p2.x, p2.y, depth / 2,
        p1.x, p1.y, depth / 2,
        p1.x, 0, -depth / 2,
        p2.x, 0, -depth / 2,
        p2.x, 0, depth / 2,
        p1.x, 0, depth / 2
      ]);
      const indices = new Uint32Array([
        0, 1, 2, 0, 2, 3,
        4, 5, 6, 4, 6, 7,
        0, 3, 7, 0, 7, 4,
        1, 5, 6, 1, 6, 2,
        3, 2, 6, 3, 6, 7,
        0, 4, 5, 0, 5, 1
      ]);
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(vertices, 3));
      geo.setIndex(new THREE.BufferAttribute(indices, 1));
      geo.computeVertexNormals();
      return geo;
    }

    function makeGlowTexture() {
      const c = document.createElement('canvas');
      c.width = c.height = 64;
      const g = c.getContext('2d');
      const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, 'rgba(255,255,255,1)');
      grad.addColorStop(0.35, 'rgba(255,255,255,0.4)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = grad;
      g.fillRect(0, 0, 64, 64);
      return new THREE.CanvasTexture(c);
    }

    let renderer, scene, camera;
    let grid = null;
    let ribbon = null;
    let halo = null;
    let slabs = [];
    let particles = null;
    let rafId = null;
    let inView = true;
    const mouse = { x: 0, y: 0 };
    let camTarget;
    let clock;

    function createGrid(palette) {
      if (grid) {
        scene.remove(grid);
        grid.geometry.dispose();
        grid.material.dispose();
      }
      grid = new THREE.GridHelper(90, 90, palette.gridMajor, palette.gridMinor);
      grid.material.transparent = true;
      grid.material.opacity = 0.5;
      scene.add(grid);
    }

    function applySceneTheme() {
      if (!scene) return;
      const palette = getScenePalette();
      scene.background.set(palette.bg);
      scene.fog.color.set(palette.fog);
      createGrid(palette);
      if (ribbon) ribbon.material.color.set(palette.curve);
      if (halo) halo.material.color.set(palette.curve);
      if (particles) particles.material.color.set(palette.dust);
      slabs.forEach((slab) => {
        slab.material.color.set(slab.userData.positive ? palette.pos : palette.neg);
      });
      if (renderer && camera) renderer.render(scene, camera);
    }

    function init() {
      const w = heroEl.clientWidth;
      const h = heroEl.clientHeight;

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(w, h);
      heroEl.appendChild(renderer.domElement);

      const palette = getScenePalette();
      scene = new THREE.Scene();
      scene.background = new THREE.Color(palette.bg);
      scene.fog = new THREE.Fog(palette.fog, 20, 52);

      camera = new THREE.PerspectiveCamera(42, w / h, 0.1, 200);
      camera.position.set(0, 6.4, 24);
      camera.lookAt(camTarget);

      scene.add(new THREE.AmbientLight(0x8fa3d9, 0.55));
      const dir = new THREE.DirectionalLight(0xffffff, 0.7);
      dir.position.set(6, 14, 10);
      scene.add(dir);

      createGrid(palette);

      const pts = buildCurvePoints();

      // luminous curve ribbon + halo
      ribbon = new THREE.Mesh(
        buildRibbon(pts, 0.14),
        new THREE.MeshBasicMaterial({ color: palette.curve, transparent: true, opacity: 0.95, side: THREE.DoubleSide, depthWrite: false })
      );
      scene.add(ribbon);

      halo = new THREE.Mesh(
        buildRibbon(pts, 1.1),
        new THREE.MeshBasicMaterial({ color: palette.curve, transparent: true, opacity: 0.07, side: THREE.DoubleSide, depthWrite: false, blending: THREE.AdditiveBlending })
      );
      scene.add(halo);

      // area slabs rising from the plane
      const slabGroup = new THREE.Group();
      for (let i = 0; i < pts.length - 1; i++) {
        const p1 = pts[i];
        const p2 = pts[i + 1];
        const isPos = (p1.y + p2.y) / 2 >= 0;
        const slab = new THREE.Mesh(
          buildSlab(p1, p2, 1.4),
          new THREE.MeshBasicMaterial({
            color: isPos ? palette.pos : palette.neg,
            transparent: true,
            opacity: 0.13,
            side: THREE.DoubleSide,
            depthWrite: false
          })
        );
        slab.userData = { delay: 0.35 + i * 0.028, baseY: 1, phase: i * 0.32, positive: isPos };
        slab.scale.y = 0;
        slabGroup.add(slab);
        slabs.push(slab);
      }
      scene.add(slabGroup);

      // drifting dust
      const count = 240;
      const positions = new Float32Array(count * 3);
      const speeds = new Float32Array(count);
      for (let i = 0; i < count; i++) {
        positions[i * 3] = (Math.random() - 0.5) * 46;
        positions[i * 3 + 1] = Math.random() * 16 - 2;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 26;
        speeds[i] = 0.12 + Math.random() * 0.3;
      }
      const pGeo = new THREE.BufferGeometry();
      pGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      particles = new THREE.Points(
        pGeo,
        new THREE.PointsMaterial({
          size: 0.09,
          map: makeGlowTexture(),
          color: palette.dust,
          transparent: true,
          opacity: 0.45,
          depthWrite: false,
          blending: THREE.AdditiveBlending
        })
      );
      particles.userData = { speeds };
      scene.add(particles);

      window.addEventListener('pointermove', (e) => {
        mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
        mouse.y = (e.clientY / window.innerHeight) * 2 - 1;
      }, { passive: true });

      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          inView = entries[0].isIntersecting;
        }, { threshold: 0.02 }).observe(heroEl);
      }

      if (reducedMotion) {
        slabs.forEach((s) => { s.scale.y = 1; });
        renderer.render(scene, camera);
      } else {
        loop();
      }
    }

    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

    function loop() {
      rafId = requestAnimationFrame(loop);
      if (!inView) return;

      const t = clock.getElapsedTime();

      for (const slab of slabs) {
        const local = Math.min(Math.max((t - slab.userData.delay) / 0.9, 0), 1);
        const grown = easeOutCubic(local);
        const breathe = 1 + 0.018 * Math.sin(t * 0.9 + slab.userData.phase);
        slab.scale.y = grown * breathe;
      }

      if (particles) {
        const pos = particles.geometry.attributes.position;
        const speeds = particles.userData.speeds;
        for (let i = 0; i < speeds.length; i++) {
          let y = pos.getY(i) + speeds[i] * 0.016;
          if (y > 15) y = -2;
          pos.setY(i, y);
        }
        pos.needsUpdate = true;
      }

      const px = mouse.x * 1.6;
      const py = -mouse.y * 0.9;
      camera.position.x += (px - camera.position.x) * 0.03;
      camera.position.y += (6.4 + py - camera.position.y) * 0.03;
      camera.lookAt(camTarget);

      renderer.render(scene, camera);
    }

    function onResize() {
      if (!renderer || !camera) return;
      const w = heroEl.clientWidth;
      const h = heroEl.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }

    if (!isMobile && heroEl) {
      window.addEventListener('themechange', applySceneTheme);
      (async () => {
        THREE = await import('three');
        camTarget = new THREE.Vector3(0, 1.6, 0);
        clock = new THREE.Clock();
        window.addEventListener('resize', onResize, { passive: true });
        init();
      })();
    }
  </script>

  <!-- ============ DRAWING INSTRUMENT (2D canvas) ============ -->
  <script>
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');

    function cssVar(name, fallback) {
      const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return value || fallback;
    }
    const calculateBtn = document.getElementById('calculateBtn');
    const clearBtn = document.getElementById('clearBtn');
    const errorMessage = document.getElementById('errorMessage');
    const loadingIndicator = document.getElementById('loadingIndicator');
    const resultsSummary = document.getElementById('resultsSummary');
    const pointCount = document.getElementById('pointCount');
    const coordReadout = document.getElementById('coordReadout');
    const validateBtn = document.getElementById('validateBtn');
    const recognizeBtn = document.getElementById('recognizeBtn');
    const drawAnalysisPanel = document.getElementById('drawAnalysisPanel');
    const analysisBadge = document.getElementById('analysisBadge');
    const analysisBadgeText = document.getElementById('analysisBadgeText');
    const validationReport = document.getElementById('validationReport');
    const recognitionBox = document.getElementById('recognitionBox');
    const recognitionNote = document.getElementById('recognitionNote');
    const candidateList = document.getElementById('candidateList');
    const closeRecognitionBtn = document.getElementById('closeRecognitionBtn');
    const recognizedHint = document.getElementById('recognizedHint');
    const funcInput = document.getElementById('funcInput');

    let points = [];
    let isDrawing = false;
    let coordinateSystem = null;
    let lastValidation = null;
    let validatedSignature = null;
    let analysisRequestId = 0;
    let inferredExpression = '';

    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const cssHeight = Math.max(320, Math.min(560, rect.width * 0.62));
      canvas.width = rect.width * dpr;
      canvas.height = cssHeight * dpr;
      canvas.style.width = rect.width + 'px';
      canvas.style.height = cssHeight + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const width = rect.width;
      const height = cssHeight;

      coordinateSystem = {
        originX: width / 2,
        originY: height / 2,
        scaleX: width / 12,
        scaleY: height / 12,
        canvasWidth: width,
        canvasHeight: height,
        screenToMath: (screenX, screenY) => ({
          x: (screenX - coordinateSystem.originX) / coordinateSystem.scaleX,
          y: (coordinateSystem.originY - screenY) / coordinateSystem.scaleY
        }),
        mathToScreen: (mathX, mathY) => ({
          x: coordinateSystem.originX + mathX * coordinateSystem.scaleX,
          y: coordinateSystem.originY - mathY * coordinateSystem.scaleY
        })
      };

      if (inputMode === 'function' && points.length >= 2) {
        fitViewToPoints();
      }

      draw();
    }

    function resetView() {
      const { canvasWidth, canvasHeight } = coordinateSystem;
      coordinateSystem.originX = canvasWidth / 2;
      coordinateSystem.originY = canvasHeight / 2;
      coordinateSystem.scaleX = canvasWidth / 12;
      coordinateSystem.scaleY = canvasHeight / 12;
    }

    function fitViewToPoints() {
      if (points.length < 2) return;
      let minX = Infinity, maxX = -Infinity, minY = 0, maxY = 0;
      for (const p of points) {
        if (p.x < minX) minX = p.x;
        if (p.x > maxX) maxX = p.x;
        if (p.y < minY) minY = p.y;
        if (p.y > maxY) maxY = p.y;
      }
      const padX = Math.max((maxX - minX) * 0.08, 1e-4);
      const padY = Math.max((maxY - minY) * 0.18, 1e-4);
      const viewW = Math.max(maxX - minX + 2 * padX, 1e-6);
      const viewH = Math.max(maxY - minY + 2 * padY, 1e-6);
      const { canvasWidth, canvasHeight } = coordinateSystem;
      coordinateSystem.scaleX = canvasWidth / viewW;
      coordinateSystem.scaleY = canvasHeight / viewH;
      coordinateSystem.originX = (padX - minX) * coordinateSystem.scaleX;
      coordinateSystem.originY = (maxY + padY) * coordinateSystem.scaleY;
    }

    function drawGrid() {
      const { originX, originY, scaleX, scaleY, canvasWidth, canvasHeight } = coordinateSystem;

      ctx.strokeStyle = cssVar('--canvas-grid', 'rgba(148, 163, 216, 0.08)');
      ctx.lineWidth = 0.5;

      for (let x = originX % scaleX; x < canvasWidth; x += scaleX) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvasHeight); ctx.stroke();
      }
      for (let x = originX - scaleX; x > 0; x -= scaleX) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvasHeight); ctx.stroke();
      }
      for (let y = originY % scaleY; y < canvasHeight; y += scaleY) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvasWidth, y); ctx.stroke();
      }
      for (let y = originY - scaleY; y > 0; y -= scaleY) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvasWidth, y); ctx.stroke();
      }
    }

    function drawAxes() {
      const { xAxisScreenY, yAxisScreenX, canvasWidth, canvasHeight } = coordinateSystem;

      ctx.strokeStyle = cssVar('--canvas-axis', 'rgba(148, 163, 216, 0.45)');
      ctx.lineWidth = 1;

      ctx.beginPath(); ctx.moveTo(0, xAxisScreenY); ctx.lineTo(canvasWidth, xAxisScreenY); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(yAxisScreenX, 0); ctx.lineTo(yAxisScreenX, canvasHeight); ctx.stroke();
    }

    function drawAxisLabels() {
      const { originX, originY, scaleX, scaleY, canvasWidth, canvasHeight, mathToScreen } = coordinateSystem;

      ctx.fillStyle = cssVar('--canvas-label', 'rgba(102, 112, 143, 0.85)');
      ctx.font = '10px "JetBrains Mono", monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';

      for (let x = originX + scaleX, val = 1; x < canvasWidth; x += scaleX, val++) {
        const screen = mathToScreen(val, 0);
        ctx.fillText(val.toString(), screen.x, originY + 5);
      }
      for (let x = originX - scaleX, val = -1; x > 0; x -= scaleX, val--) {
        const screen = mathToScreen(val, 0);
        ctx.fillText(val.toString(), screen.x, originY + 5);
      }

      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      for (let y = originY + scaleY, val = -1; y < canvasHeight; y += scaleY, val--) {
        const screen = mathToScreen(0, val);
        ctx.fillText(val.toString(), originX + 6, screen.y);
      }
      for (let y = originY - scaleY, val = 1; y > 0; y -= scaleY, val++) {
        const screen = mathToScreen(0, val);
        ctx.fillText(val.toString(), originX + 6, screen.y);
      }

      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      ctx.fillText('0', originX + 6, originY + 5);
    }

    // Trapezoid fills under the curve — each segment tinted by its sign,
    // mirroring the numerical rule that will be applied.
    function drawTrapezoidFills() {
      if (points.length < 2) return;
      const { mathToScreen } = coordinateSystem;
      const axisY = coordinateSystem.originY;

      for (let i = 0; i < points.length - 1; i++) {
        const p1 = points[i];
        const p2 = points[i + 1];
        const s1 = mathToScreen(p1.x, p1.y);
        const s2 = mathToScreen(p2.x, p2.y);
        const avgY = (p1.y + p2.y) / 2;

        ctx.beginPath();
        ctx.moveTo(s1.x, s1.y);
        ctx.lineTo(s2.x, s2.y);
        ctx.lineTo(s2.x, axisY);
        ctx.lineTo(s1.x, axisY);
        ctx.closePath();
        ctx.fillStyle = avgY >= 0
          ? cssVar('--canvas-pos', 'rgba(157, 123, 255, 0.13)')
          : cssVar('--canvas-neg', 'rgba(255, 107, 139, 0.13)');
        ctx.fill();
      }
    }

    function drawCurve() {
      if (points.length < 2) {
        if (points.length === 1) {
          const s = coordinateSystem.mathToScreen(points[0].x, points[0].y);
          ctx.fillStyle = cssVar('--canvas-curve', '#2dd4ee');
          ctx.beginPath();
          ctx.arc(s.x, s.y, 3.5, 0, Math.PI * 2);
          ctx.fill();
        }
        return;
      }

      ctx.strokeStyle = cssVar('--canvas-curve', '#2dd4ee');
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.shadowColor = cssVar('--canvas-glow', 'rgba(45, 212, 238, 0.55)');
      ctx.shadowBlur = 12;

      ctx.beginPath();
      for (let i = 0; i < points.length; i++) {
        const screen = coordinateSystem.mathToScreen(points[i].x, points[i].y);
        if (i === 0) ctx.moveTo(screen.x, screen.y);
        else ctx.lineTo(screen.x, screen.y);
      }
      ctx.stroke();
      ctx.shadowBlur = 0;

      ctx.fillStyle = cssVar('--canvas-curve', '#2dd4ee');
      for (const p of points) {
        const screen = coordinateSystem.mathToScreen(p.x, p.y);
        ctx.beginPath();
        ctx.arc(screen.x, screen.y, 2.6, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function draw() {
      if (!coordinateSystem) return;
      const { canvasWidth, canvasHeight } = coordinateSystem;
      ctx.clearRect(0, 0, canvasWidth, canvasHeight);
      drawGrid();
      drawTrapezoidFills();
      drawAxes();
      drawAxisLabels();
      drawCurve();
    }

    window.addEventListener('themechange', () => {
      if (coordinateSystem) draw();
    });

    function getCanvasPoint(e) {
      const rect = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return { x: clientX - rect.left, y: clientY - rect.top };
    }

    function startDrawing(e) {
      if (points.length >= 5000) {
        showError('El dibujo alcanzó el máximo de 5000 puntos. Limpia o continúa con una función.');
        return;
      }
      isDrawing = true;
      hideInferredHint();
      invalidateAnalysis();
      const pt = getCanvasPoint(e);
      const mathPt = coordinateSystem.screenToMath(pt.x, pt.y);
      points.push({ x: mathPt.x, y: mathPt.y });
      sessionStorage.removeItem('functionSpec');
      sessionStorage.removeItem('recognizedFunction');
      sessionStorage.removeItem('calculusResult');
      resultsSummary.style.display = 'none';
      updateUI();
      savePoints();
      draw();
      e.preventDefault();
    }

    function drawPoint(e) {
      const pt = getCanvasPoint(e);
      const mathPt = coordinateSystem.screenToMath(pt.x, pt.y);
      coordReadout.innerHTML = `x: ${mathPt.x.toFixed(2)}&nbsp;&nbsp;y: ${mathPt.y.toFixed(2)}`;
      coordReadout.classList.add('visible');
      if (!isDrawing) return;
      if (points.length >= 5000) return;
      invalidateAnalysis();
      points.push({ x: mathPt.x, y: mathPt.y });
      updateUI();
      savePoints();
      draw();
      e.preventDefault();
    }

    function stopDrawing() {
      isDrawing = false;
    }

    function updateUI() {
      pointCount.textContent = `Puntos: ${points.length}`;
      calculateBtn.disabled = points.length < 2;
      clearBtn.disabled = points.length === 0;
      validateBtn.disabled = points.length < 2;
      recognizeBtn.disabled = points.length < 8;
    }

    function savePoints() {
      if (points.length > 0) {
        sessionStorage.setItem('drawnPoints', JSON.stringify(points));
      }
    }

    function showError(msg) {
      errorMessage.style.display = 'flex';
      errorMessage.innerHTML = `
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span></span>
      `;
      errorMessage.querySelector('span').textContent = msg;
    }

    function hideError() {
      errorMessage.style.display = 'none';
    }

    function apiErrorMessage(data, fallback) {
      if (typeof data?.detail === 'string') return data.detail;
      if (Array.isArray(data?.detail)) {
        return data.detail.map((item) => item.msg || '').filter(Boolean).join(' · ') || fallback;
      }
      return fallback;
    }

    function pointsSignature() {
      if (!points.length) return '0';
      const first = points[0];
      const last = points[points.length - 1];
      return [
        points.length,
        first.x.toFixed(6),
        first.y.toFixed(6),
        last.x.toFixed(6),
        last.y.toFixed(6)
      ].join(':');
    }

    function formatPercent(value) {
      return typeof value === 'number' && Number.isFinite(value)
        ? `${(value * 100).toFixed(1)}%`
        : '—';
    }

    function setAnalysisBadge(label, tone) {
      analysisBadgeText.textContent = label;
      analysisBadge.className = `badge ${tone}`;
    }

    function showInferredHint(expression, confidence = '') {
      inferredExpression = expression;
      recognizedHint.textContent = `Expresión inferida del dibujo${confidence ? ` (confianza ${confidence})` : ''}: ${expression}. Revisa la expresión antes de calcular; puedes editarla.`;
      recognizedHint.classList.remove('hidden');
    }

    function hideInferredHint() {
      inferredExpression = '';
      recognizedHint.textContent = '';
      recognizedHint.classList.add('hidden');
    }

    function invalidateAnalysis() {
      lastValidation = null;
      validatedSignature = null;
      analysisRequestId += 1;
      drawAnalysisPanel.classList.add('hidden');
      recognitionBox.classList.add('hidden');
      candidateList.replaceChildren();
      sessionStorage.removeItem('drawingValidation');
    }

    function renderValidation(data) {
      drawAnalysisPanel.classList.remove('hidden');
      validationReport.replaceChildren();

      const tone = data.status === 'valid' ? 'badge-valid' : data.status === 'invalid' ? 'badge-invalid' : 'badge-uncertain';
      const label = data.status === 'valid' ? 'Válido' : data.status === 'invalid' ? 'No válido' : 'Incierto';
      setAnalysisBadge(label, tone);

      const box = document.createElement('div');
      box.className = `analysis-result ${data.status}`;

      const message = document.createElement('p');
      message.className = 'analysis-message';
      message.textContent = data.message;
      box.appendChild(message);

      const reason = document.createElement('p');
      reason.className = 'analysis-reason mono';
      reason.textContent = `Diagnóstico: ${data.reason_code}`;
      box.appendChild(reason);

      const meta = data.diagnostics || {};
      const chips = document.createElement('div');
      chips.className = 'analysis-chips';
      const values = [
        ['Puntos', meta.point_count ?? '—'],
        ['Dirección', meta.direction === 'increasing'
          ? 'creciente'
          : meta.direction === 'decreasing'
            ? 'decreciente'
            : meta.direction === 'mixed'
              ? 'mixta'
              : '—'],
        ['Retroceso', formatPercent(meta.backtrack_ratio)],
        ['Ruido', formatPercent(meta.noise_ratio)],
        ['Saltos', meta.gaps ?? 0],
        ['Cruces propios', meta.self_intersections ?? 0]
      ];
      for (const [name, value] of values) {
        const chip = document.createElement('span');
        chip.className = 'analysis-chip';
        const nameEl = document.createElement('span');
        nameEl.textContent = name;
        const valueEl = document.createElement('strong');
        valueEl.textContent = String(value);
        chip.append(nameEl, valueEl);
        chips.appendChild(chip);
      }
      box.appendChild(chips);

      const ambiguous = Array.isArray(meta.ambiguous_regions) ? meta.ambiguous_regions : [];
      if (ambiguous.length) {
        const note = document.createElement('p');
        note.className = 'analysis-note';
        note.textContent = `${ambiguous.length} región(es) ambigua(s) detectada(s). Revisa el tramo señalado antes de calcular.`;
        box.appendChild(note);
      }

      const details = document.createElement('details');
      details.className = 'analysis-details';
      const summary = document.createElement('summary');
      summary.textContent = 'Criterios utilizados';
      details.appendChild(summary);
      const list = document.createElement('ul');
      for (const criterion of meta.criteria || []) {
        const item = document.createElement('li');
        item.textContent = criterion;
        list.appendChild(item);
      }
      details.appendChild(list);
      box.appendChild(details);

      validationReport.appendChild(box);
    }

    async function requestValidation() {
      if (points.length < 2) {
        showError('Dibuja al menos dos puntos para validar el trazo.');
        return null;
      }
      const requestId = ++analysisRequestId;
      validateBtn.disabled = true;
      recognizeBtn.disabled = true;
      setAnalysisBadge('Analizando…', 'badge-pending');
      drawAnalysisPanel.classList.remove('hidden');
      hideError();

      try {
        const response = await fetch('/api/validate-drawing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ points })
        });
        const data = await response.json();
        if (requestId !== analysisRequestId) return null;
        if (!response.ok) {
          throw new Error(apiErrorMessage(data, 'No se pudo validar el dibujo.'));
        }
        lastValidation = data;
        validatedSignature = pointsSignature();
        sessionStorage.setItem('drawingValidation', JSON.stringify(data));
        renderValidation(data);
        if (data.status !== 'valid') showError(data.message);
        return data;
      } catch (err) {
        if (requestId === analysisRequestId) {
          setAnalysisBadge('Error', 'badge-invalid');
          showError(err.message);
        }
        return null;
      } finally {
        if (requestId === analysisRequestId) {
          validateBtn.disabled = points.length < 2;
          recognizeBtn.disabled = points.length < 8;
        }
      }
    }

    async function ensureDrawValid() {
      if (inputMode !== 'draw') return true;
      if (lastValidation && validatedSignature === pointsSignature()) {
        if (lastValidation.status === 'valid') return true;
        showError(lastValidation.message);
        return false;
      }
      const result = await requestValidation();
      return Boolean(result && result.status === 'valid');
    }

    function metricText(metrics, key, digits = 2) {
      const value = metrics?.[key];
      return typeof value === 'number' && Number.isFinite(value)
        ? value.toExponential(digits)
        : '—';
    }

    function acceptCandidate(candidate, confidence = '') {
      funcInput.value = candidate.expression;
      rangeStart.value = String(candidate.domain.start);
      rangeEnd.value = String(candidate.domain.end);
      showInferredHint(candidate.expression, confidence);
      sessionStorage.setItem('recognizedFunction', JSON.stringify({
        expression: candidate.expression,
        domain: candidate.domain,
        metrics: candidate.metrics,
        model: candidate.model
      }));
      sessionStorage.removeItem('drawingValidation');
      setMode('function');
      plotFunction();
    }

    function renderRecognition(data) {
      if (data.validation) renderValidation(data.validation);
      drawAnalysisPanel.classList.remove('hidden');
      recognitionBox.classList.remove('hidden');
      candidateList.replaceChildren();

      const noteText = {
        success: 'Se encontró un modelo compatible. Revisa la expresión y acéptala si representa tu dibujo.',
        low_confidence: 'Hay candidatos, pero el ajuste no es concluyente. No se usará automáticamente.',
        no_fit: 'No se encontró un modelo compatible con suficiente confianza.',
        invalid: 'El dibujo no es válido como función y = f(x); no se intentará ajustar.',
        uncertain: 'El dibujo es ambiguo o insuficiente; corrige el trazo antes de reconocer una función.'
      }[data.status] || 'Reconocimiento terminado.';
      recognitionNote.textContent = `${noteText}${data.confidence ? ` Confianza: ${data.confidence}.` : ''}`;

      if (Array.isArray(data.warnings) && data.warnings.length) {
        const warnings = document.createElement('ul');
        warnings.className = 'analysis-warnings';
        for (const warning of data.warnings) {
          const item = document.createElement('li');
          item.textContent = warning;
          warnings.appendChild(item);
        }
        recognitionNote.appendChild(warnings);
      }

      const candidates = Array.isArray(data.candidates) ? data.candidates : [];
      if (!candidates.length) {
        const empty = document.createElement('p');
        empty.className = 'field-help';
        empty.textContent = 'No hay expresiones candidatas para mostrar.';
        candidateList.appendChild(empty);
        if (data.status === 'invalid') {
          setAnalysisBadge('No válida', 'badge-invalid');
        } else if (data.status === 'uncertain') {
          setAnalysisBadge('Incierta', 'badge-uncertain');
        } else {
          setAnalysisBadge('Sin candidatos', 'badge-uncertain');
        }
        return;
      }

      setAnalysisBadge(data.recognized ? 'Reconocida' : 'Revisar', data.recognized ? 'badge-valid' : 'badge-uncertain');
      for (const candidate of candidates) {
        const card = document.createElement('article');
        card.className = 'candidate-card';

        const head = document.createElement('div');
        head.className = 'candidate-head';
        const model = document.createElement('span');
        model.className = 'candidate-model';
        model.textContent = `${candidate.label} · complejidad ${candidate.complexity}`;
        head.appendChild(model);
        if (candidate.expression === data.expression && data.recognized) {
          const badge = document.createElement('span');
          badge.className = 'badge badge-valid';
          badge.textContent = 'Recomendada';
          head.appendChild(badge);
        }
        card.appendChild(head);

        const expression = document.createElement('code');
        expression.className = 'candidate-expression';
        expression.textContent = `f(x) = ${candidate.expression}`;
        card.appendChild(expression);

        const metrics = document.createElement('div');
        metrics.className = 'candidate-metrics mono';
        metrics.textContent = `RMSE ${metricText(candidate.metrics, 'rmse')} · Error rel. ${formatPercent(candidate.metrics?.relative_error)} · Máx. ${metricText(candidate.metrics, 'max_error')}`;
        if (candidate.metrics?.validation_rmse !== undefined) {
          metrics.textContent += ` · Validación ${metricText(candidate.metrics, 'validation_rmse')}`;
        }
        card.appendChild(metrics);

        for (const warning of candidate.warnings || []) {
          const warningEl = document.createElement('p');
          warningEl.className = 'candidate-warning';
          warningEl.textContent = warning;
          card.appendChild(warningEl);
        }

        const actions = document.createElement('div');
        actions.className = 'candidate-actions';
        const use = document.createElement('button');
        use.type = 'button';
        use.className = 'btn btn-primary btn-sm';
        use.textContent = 'Usar esta función';
        use.addEventListener('click', () => acceptCandidate(candidate, data.confidence || ''));
        actions.appendChild(use);
        card.appendChild(actions);

        candidateList.appendChild(card);
      }
    }

    async function recognizeDrawing() {
      if (points.length < 8) {
        showError('Dibuja una curva más larga para intentar reconocer una función.');
        return;
      }
      const requestId = ++analysisRequestId;
      validateBtn.disabled = true;
      recognizeBtn.disabled = true;
      setAnalysisBadge('Reconociendo…', 'badge-pending');
      drawAnalysisPanel.classList.remove('hidden');
      recognitionBox.classList.add('hidden');
      hideError();

      try {
        const response = await fetch('/api/recognize-function', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ points })
        });
        const data = await response.json();
        if (requestId !== analysisRequestId) return;
        if (!response.ok) {
          throw new Error(apiErrorMessage(data, 'No se pudo reconocer la función.'));
        }
        renderRecognition(data);
      } catch (err) {
        if (requestId === analysisRequestId) {
          setAnalysisBadge('Error', 'badge-invalid');
          showError(err.message);
        }
      } finally {
        if (requestId === analysisRequestId) {
          validateBtn.disabled = points.length < 2;
          recognizeBtn.disabled = points.length < 8;
        }
      }
    }

    async function calculateArea() {
      if (points.length < 2) return;

      const valid = await ensureDrawValid();
      if (!valid) return;

      hideError();
      calculateBtn.disabled = true;
      clearBtn.disabled = true;
      loadingIndicator.style.display = 'block';
      resultsSummary.style.display = 'none';

      try {
        const response = await fetch('/api/calculate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ points })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(apiErrorMessage(data, 'Error en el cálculo'));
        }

        data.original_points = points.length;
        sessionStorage.setItem('calculusResult', JSON.stringify(data));

        document.getElementById('signedIntegral').textContent = data.signed_integral.toFixed(4);
        document.getElementById('totalArea').textContent = data.total_geometric_area.toFixed(4);
        document.getElementById('positiveArea').textContent = data.positive_area.toFixed(4);
        document.getElementById('negativeArea').textContent = data.negative_area.toFixed(4);

        resultsSummary.style.display = 'block';
        document.getElementById('resultsActions').style.display = 'flex';
        resultsSummary.scrollIntoView({ behavior: reducedMotionCheck() ? 'auto' : 'smooth', block: 'nearest' });

      } catch (err) {
        showError(err.message);
        document.getElementById('resultsActions').style.display = 'flex';
      } finally {
        loadingIndicator.style.display = 'none';
        calculateBtn.disabled = points.length < 2;
        clearBtn.disabled = points.length === 0;
      }
    }

    function reducedMotionCheck() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function clearCurve() {
      points = [];
      hideInferredHint();
      lastValidation = null;
      validatedSignature = null;
      analysisRequestId += 1;
      updateUI();
      hideError();
      resultsSummary.style.display = 'none';
      document.getElementById('resultsActions').style.display = 'none';
      drawAnalysisPanel.classList.add('hidden');
      recognitionBox.classList.add('hidden');
      candidateList.replaceChildren();
      sessionStorage.removeItem('drawnPoints');
      sessionStorage.removeItem('functionSpec');
      sessionStorage.removeItem('drawingValidation');
      sessionStorage.removeItem('recognizedFunction');
      if (inputMode === 'function') setMode('draw');
      resetView();
      draw();
    }

    // ---------- Mode toggle: freehand vs. function ----------

    const modeDraw = document.getElementById('modeDraw');
    const modeFunc = document.getElementById('modeFunc');
    const functionPanel = document.getElementById('functionPanel');
    const rangeStart = document.getElementById('rangeStart');
    const rangeEnd = document.getElementById('rangeEnd');
    const samplesInput = document.getElementById('samplesInput');
    const plotFuncBtn = document.getElementById('plotFuncBtn');
    const loadingNote = loadingIndicator.querySelector('.loading-note');

    let inputMode = 'draw';

    function getSampleCount() {
      const parsed = parseInt(samplesInput.value, 10);
      const samples = Number.isFinite(parsed) ? Math.min(2000, Math.max(20, parsed)) : 240;
      samplesInput.value = String(samples);
      return samples;
    }

    function setMode(mode) {
      inputMode = mode;
      const isFunc = mode === 'function';
      modeDraw.classList.toggle('active', !isFunc);
      modeFunc.classList.toggle('active', isFunc);
      modeDraw.setAttribute('aria-selected', String(!isFunc));
      modeFunc.setAttribute('aria-selected', String(isFunc));
      functionPanel.style.display = isFunc ? 'block' : 'none';
      canvas.style.pointerEvents = isFunc ? 'none' : 'auto';
      coordReadout.classList.remove('visible');
      document.querySelectorAll('.draw-only').forEach((element) => {
        element.classList.toggle('hidden', isFunc);
      });
      if (isFunc) {
        drawAnalysisPanel.classList.add('hidden');
        recognitionBox.classList.add('hidden');
      }
      if (!isFunc) {
        resetView();
      } else if (points.length >= 2) {
        fitViewToPoints();
      }
      draw();
    }

    modeDraw.addEventListener('click', () => setMode('draw'));
    modeFunc.addEventListener('click', () => {
      hideInferredHint();
      setMode('function');
    });

    document.querySelectorAll('.hint-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        hideInferredHint();
        funcInput.value = chip.dataset.expr || '';
        funcInput.focus();
      });
    });

    funcInput.addEventListener('input', hideInferredHint);

    funcInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        plotFunction();
      }
    });

    function saveFunctionSpec() {
      sessionStorage.setItem('functionSpec', JSON.stringify({
        expression: funcInput.value.trim(),
        start: rangeStart.value,
        end: rangeEnd.value,
        samples: getSampleCount(),
        inferred: inferredExpression
      }));
    }

    async function plotFunction() {
      const expression = funcInput.value.trim();
      const start = parseFloat(rangeStart.value);
      const end = parseFloat(rangeEnd.value);
      const samples = getSampleCount();

      hideError();

      if (!expression) {
        showError('Escribe una función f(x) para graficar.');
        funcInput.focus();
        return;
      }
      if (!isFinite(start) || !isFinite(end)) {
        showError('Los límites del intervalo deben ser números.');
        return;
      }
      if (start >= end) {
        showError('El inicio del intervalo debe ser menor que el fin.');
        return;
      }

      plotFuncBtn.disabled = true;
      calculateBtn.disabled = true;
      clearBtn.disabled = true;
      loadingNote.textContent = 'Muestreando la función…';
      loadingIndicator.style.display = 'block';
      resultsSummary.style.display = 'none';

      try {
        const response = await fetch('/api/evaluate-function', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ expression, start, end, samples })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(apiErrorMessage(data, 'No se pudo graficar la función.'));
        }

        points = data.points;
        invalidateAnalysis();
        updateUI();
        savePoints();
        saveFunctionSpec();
        fitViewToPoints();
        draw();

        await calculateArea();
      } catch (err) {
        showError(err.message);
      } finally {
        plotFuncBtn.disabled = false;
        loadingIndicator.style.display = 'none';
        loadingNote.textContent = 'Calculando la integral…';
        calculateBtn.disabled = points.length < 2;
        clearBtn.disabled = points.length === 0;
      }
    }

    plotFuncBtn.addEventListener('click', plotFunction);
    validateBtn.addEventListener('click', requestValidation);
    recognizeBtn.addEventListener('click', recognizeDrawing);
    closeRecognitionBtn.addEventListener('click', () => {
      recognitionBox.classList.add('hidden');
    });

    canvas.addEventListener('mousedown', startDrawing);
    canvas.addEventListener('mousemove', drawPoint);
    canvas.addEventListener('mouseup', stopDrawing);
    canvas.addEventListener('mouseleave', () => {
      stopDrawing();
      coordReadout.classList.remove('visible');
    });

    canvas.addEventListener('touchstart', startDrawing, { passive: false });
    canvas.addEventListener('touchmove', drawPoint, { passive: false });
    canvas.addEventListener('touchend', stopDrawing);

    calculateBtn.addEventListener('click', calculateArea);
    clearBtn.addEventListener('click', clearCurve);

    window.addEventListener('resize', resizeCanvas);

    resizeCanvas();

    // Restore a previously drawn curve after navigation
    const saved = sessionStorage.getItem('drawnPoints');
    if (saved) {
      try {
        points = JSON.parse(saved);
        if (Array.isArray(points) && points.length) updateUI();
      } catch (e) { /* ignore */ }
    }

    // Restore a previously plotted function after navigation
    const savedSpec = sessionStorage.getItem('functionSpec');
    if (savedSpec && points.length >= 2) {
      try {
        const spec = JSON.parse(savedSpec);
        funcInput.value = spec.expression || '';
        if (spec.start !== undefined) rangeStart.value = spec.start;
        if (spec.end !== undefined) rangeEnd.value = spec.end;
        if (spec.samples !== undefined) samplesInput.value = spec.samples;
        if (typeof spec.inferred === 'string' && spec.inferred) {
          showInferredHint(spec.inferred);
        }
        setMode('function');
      } catch (e) { /* ignore */ }
    } else if (points.length >= 2) {
      const savedValidation = sessionStorage.getItem('drawingValidation');
      if (savedValidation) {
        try {
          const validation = JSON.parse(savedValidation);
          if (validation && validation.status) {
            lastValidation = validation;
            validatedSignature = pointsSignature();
            renderValidation(validation);
          }
        } catch (e) { /* ignore */ }
      }
    }
  </script>
</Layout>
