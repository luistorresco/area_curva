---
import Layout from '../layouts/Layout.astro';
---
<Layout title="CalculusApp - Cálculo bajo la curva">
  <div class="container">
    <header style="padding: 24px 0; text-align: center;">
      <h1 style="font-size: 28px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">
        Cálculo bajo la curva
      </h1>
      <p style="color: var(--text-secondary); font-size: 16px;">Dibuja una función y calcula su área mediante integración numérica</p>
    </header>

    <div class="card" style="margin-bottom: 24px;">
      <div class="card-header">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <h2 style="font-size: 18px; font-weight: 600; color: var(--text-primary);">Plano Cartesiano</h2>
          <div class="info-badge" id="pointCount">Puntos: 0</div>
        </div>
      </div>
      <div class="card-body" style="padding: 0;">
        <canvas id="canvas" width="800" height="600" style="display: block; width: 100%; height: auto; touch-action: none;"></canvas>
      </div>
    </div>

    <div id="errorMessage" style="display: none; margin-bottom: 16px;"></div>

    <div class="toolbar" role="toolbar" aria-label="Controles de cálculo">
      <button id="calculateBtn" class="btn btn-primary" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        Calcular área
      </button>
      <button id="clearBtn" class="btn btn-secondary" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
        Limpiar
      </button>
    </div>

    <div id="loadingIndicator" style="display: none; margin-top: 16px;">
      <div class="progress-bar">
        <div class="progress-bar-fill" style="width: 100%; animation: pulse 1.5s infinite;"></div>
      </div>
      <p style="text-align: center; margin-top: 12px; color: var(--text-secondary);">Calculando...</p>
    </div>

    <div id="resultsSummary" style="display: none; margin-top: 24px;">
      <div class="card">
        <div class="card-header">
          <h2 style="font-size: 18px; font-weight: 600; color: var(--text-primary);">Resultados</h2>
        </div>
        <div class="card-body">
          <div class="result-grid">
            <div class="result-card">
              <div class="result-label">Integral firmada</div>
              <div class="result-value" id="signedIntegral">0.0000</div>
            </div>
            <div class="result-card total">
              <div class="result-label">Área geométrica total</div>
              <div class="result-value" id="totalArea">0.0000</div>
            </div>
            <div class="result-card positive">
              <div class="result-label">Área positiva</div>
              <div class="result-value" id="positiveArea">0.0000</div>
            </div>
            <div class="result-card negative">
              <div class="result-label">Área negativa</div>
              <div class="result-value" id="negativeArea">0.0000</div>
            </div>
          </div>
          <div style="margin-top: 16px; text-align: center;">
            <a href="/results/" class="btn btn-primary">Ver detalles y fórmulas</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
  </style>

  <script>
    // Canvas drawing logic
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    const calculateBtn = document.getElementById('calculateBtn');
    const clearBtn = document.getElementById('clearBtn');
    const errorMessage = document.getElementById('errorMessage');
    const loadingIndicator = document.getElementById('loadingIndicator');
    const resultsSummary = document.getElementById('resultsSummary');
    const pointCount = document.getElementById('pointCount');

    let points = [];
    let isDrawing = false;
    let coordinateSystem = null;
    let lastResult = null;

    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      canvas.style.width = rect.width + 'px';
      canvas.style.height = rect.height + 'px';
      ctx.scale(dpr, dpr);
      
      const width = rect.width;
      const height = rect.height;
      
      coordinateSystem = {
        originX: width / 2,
        originY: height / 2,
        scaleX: width / 10,
        scaleY: height / 10,
        canvasWidth: width,
        canvasHeight: height,
        screenToMath: (screenX, screenY) => ({
          x: (screenX - width / 2) / (width / 10),
          y: (height / 2 - screenY) / (height / 10)
        }),
        mathToScreen: (mathX, mathY) => ({
          x: width / 2 + mathX * (width / 10),
          y: height / 2 - mathY * (height / 10)
        }),
        xAxisScreenY: height / 2,
        yAxisScreenX: width / 2
      };
      
      draw();
    }

    function drawGrid() {
      const { originX, originY, scaleX, scaleY, canvasWidth, canvasHeight } = coordinateSystem;
      
      ctx.strokeStyle = 'rgba(100, 116, 139, 0.15)';
      ctx.lineWidth = 0.5;
      
      // Vertical lines
      for (let x = originX % scaleX; x < canvasWidth; x += scaleX) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvasHeight);
        ctx.stroke();
      }
      for (let x = originX - scaleX; x > 0; x -= scaleX) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvasHeight);
        ctx.stroke();
      }
      
      // Horizontal lines
      for (let y = originY % scaleY; y < canvasHeight; y += scaleY) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvasWidth, y);
        ctx.stroke();
      }
      for (let y = originY - scaleY; y > 0; y -= scaleY) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvasWidth, y);
        ctx.stroke();
      }
    }

    function drawAxes() {
      const { originX, originY, xAxisScreenY, yAxisScreenX, canvasWidth, canvasHeight } = coordinateSystem;
      
      ctx.strokeStyle = 'rgba(100, 116, 139, 0.5)';
      ctx.lineWidth = 1;
      
      // X axis
      ctx.beginPath();
      ctx.moveTo(0, xAxisScreenY);
      ctx.lineTo(canvasWidth, xAxisScreenY);
      ctx.stroke();
      
      // Y axis
      ctx.beginPath();
      ctx.moveTo(yAxisScreenX, 0);
      ctx.lineTo(yAxisScreenX, canvasHeight);
      ctx.stroke();
    }

    function drawAxisLabels() {
      const { originX, originY, scaleX, scaleY, canvasWidth, canvasHeight, mathToScreen } = coordinateSystem;
      
      ctx.fillStyle = 'rgba(100, 116, 139, 0.7)';
      ctx.font = '10px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      
      // X-axis labels
      for (let x = originX, val = 0; x < canvasWidth; x += scaleX, val++) {
        if (val !== 0) {
          const screen = mathToScreen(val, 0);
          if (screen.x >= 0 && screen.x <= canvasWidth) {
            ctx.fillText(val.toString(), screen.x, originY + 4);
          }
        }
      }
      for (let x = originX - scaleX, val = -1; x > 0; x -= scaleX, val--) {
        const screen = mathToScreen(val, 0);
        if (screen.x >= 0 && screen.x <= canvasWidth) {
          ctx.fillText(val.toString(), screen.x, originY + 4);
        }
      }
      
      // Y-axis labels
      for (let y = originY, val = 0; y < canvasHeight; y += scaleY, val--) {
        if (val !== 0) {
          const screen = mathToScreen(0, val);
          if (screen.y >= 0 && screen.y <= canvasHeight) {
            ctx.fillText((-val).toString(), originX + 4, screen.y - 6);
          }
        }
      }
      for (let y = originY - scaleY, val = 1; y > 0; y -= scaleY, val++) {
        const screen = mathToScreen(0, val);
        if (screen.y >= 0 && screen.y <= canvasHeight) {
          ctx.fillText((-val).toString(), originX + 4, screen.y - 6);
        }
      }
      
      // Origin
      ctx.fillText('0', originX + 4, originY + 4);
    }

    function drawCurve() {
      if (points.length < 2) return;
      
      ctx.strokeStyle = '#6366f1';
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      
      ctx.beginPath();
      for (let i = 0; i < points.length; i++) {
        const screen = coordinateSystem.mathToScreen(points[i].x, points[i].y);
        if (i === 0) {
          ctx.moveTo(screen.x, screen.y);
        } else {
          ctx.lineTo(screen.x, screen.y);
        }
      }
      ctx.stroke();
      
      // Draw points
      ctx.fillStyle = '#6366f1';
      for (const p of points) {
        const screen = coordinateSystem.mathToScreen(p.x, p.y);
        ctx.beginPath();
        ctx.arc(screen.x, screen.y, 4, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function draw() {
      if (!coordinateSystem) return;
      
      const { canvasWidth, canvasHeight } = coordinateSystem;
      ctx.clearRect(0, 0, canvasWidth, canvasHeight);
      
      drawGrid();
      drawAxes();
      drawAxisLabels();
      drawCurve();
    }

    function getCanvasPoint(e) {
      const rect = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return {
        x: clientX - rect.left,
        y: clientY - rect.top
      };
    }

    function startDrawing(e) {
      isDrawing = true;
      const pt = getCanvasPoint(e);
      const mathPt = coordinateSystem.screenToMath(pt.x, pt.y);
      points.push({ x: mathPt.x, y: mathPt.y });
      updateUI();
      savePoints();
      draw();
      e.preventDefault();
    }

    function drawPoint(e) {
      if (!isDrawing) return;
      const pt = getCanvasPoint(e);
      const mathPt = coordinateSystem.screenToMath(pt.x, pt.y);
      points.push({ x: mathPt.x, y: mathPt.y });
      updateUI();
      savePoints();
      draw();
      e.preventDefault();
    }

    function stopDrawing() {
      isDrawing = false;
    }

    function updateUI() {
      pointCount.textContent = `Puntos: ${points.length}`;
      calculateBtn.disabled = points.length < 2;
      clearBtn.disabled = points.length === 0;
    }

    function savePoints() {
      if (points.length > 0) {
        sessionStorage.setItem('drawnPoints', JSON.stringify(points));
      }
    }

    function showError(msg) {
      errorMessage.style.display = 'flex';
      errorMessage.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        ${msg}
      `;
    }

    function hideError() {
      errorMessage.style.display = 'none';
    }

    async function calculateArea() {
      if (points.length < 2) return;
      
      hideError();
      calculateBtn.disabled = true;
      clearBtn.disabled = true;
      loadingIndicator.style.display = 'block';
      
      try {
        const response = await fetch('/api/calculate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ points })
        });
        
        const data = await response.json();
        
        if (!response.ok) {
          throw new Error(data.detail || 'Error en el cálculo');
        }
        
        // Add original points count to data
        data.original_points = points.length;
        
        lastResult = data;
        
        // Save to sessionStorage for results page
        sessionStorage.setItem('calculusResult', JSON.stringify(data));
        
        document.getElementById('signedIntegral').textContent = data.signed_integral.toFixed(4);
        document.getElementById('totalArea').textContent = data.total_geometric_area.toFixed(4);
        document.getElementById('positiveArea').textContent = data.positive_area.toFixed(4);
        document.getElementById('negativeArea').textContent = data.negative_area.toFixed(4);
        
        resultsSummary.style.display = 'block';
        
      } catch (err) {
        showError(err.message);
      } finally {
        loadingIndicator.style.display = 'none';
        calculateBtn.disabled = points.length < 2;
        clearBtn.disabled = points.length === 0;
      }
    }

    function clearCurve() {
      points = [];
      lastResult = null;
      updateUI();
      hideError();
      resultsSummary.style.display = 'none';
      sessionStorage.removeItem('drawnPoints');
      draw();
    }

    // Event listeners
    canvas.addEventListener('mousedown', startDrawing);
    canvas.addEventListener('mousemove', drawPoint);
    canvas.addEventListener('mouseup', stopDrawing);
    canvas.addEventListener('mouseleave', stopDrawing);
    
    canvas.addEventListener('touchstart', startDrawing, { passive: false });
    canvas.addEventListener('touchmove', drawPoint, { passive: false });
    canvas.addEventListener('touchend', stopDrawing);
    
    calculateBtn.addEventListener('click', calculateArea);
    clearBtn.addEventListener('click', clearCurve);
    
    window.addEventListener('resize', resizeCanvas);
    
    // Initialize
    resizeCanvas();
  </script>
</Layout>